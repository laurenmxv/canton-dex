{
  "name": "@canton-dex/client",
  "version": "0.0.0",
  "description": "TypeScript client for the Canton DEX HTTP API.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vitest": "^3.2.7"
  }
}
