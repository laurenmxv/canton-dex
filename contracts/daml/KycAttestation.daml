-- | Defines the operator's KYC approvals used for pool access and settlement.
module KycAttestation where

import Pool

-- | Records KYC approval for one trader and the pools they may access.
template KycAttestation
  with
    venueOperator : Party
    trader : Party
    pools : [ContractId Pool]
  where
    signatory venueOperator
    observer trader
    ensure not (null pools)
