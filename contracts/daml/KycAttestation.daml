-- | Records the operator's KYC approval for a trader and a set of pools.
-- Pool access and settlement check that this approval is still active.
module KycAttestation where

import Pool

template KycAttestation
  with
    venueOperator : Party
    trader : Party
    pools : [ContractId Pool]
  where
    signatory venueOperator
    observer trader
    ensure not (null pools)
