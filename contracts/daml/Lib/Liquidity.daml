-- | Signed liquidity terms, proportional math and native CIP-0112 mint/burn settlement.
module Lib.Liquidity where

import DA.Assert (assertWithinDeadline)
import DA.List (dedup)
import DA.Numeric qualified as Numeric
import DA.Text qualified as Text
import Errors (eDepositBelowMinimumOutput)
import Lib.Math
import Lib.Tokens
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.MetadataV1 (ExtraArgs, emptyMetadata)
import Splice.TokenStandard.Utils (basicAccount, mintAccount, burnAccount, senderSide, receiverSide, toAnyContractId)

data LiquidityRoute pool = LiquidityRoute with
    poolCid : ContractId pool
    dvo : Party
    venueOperator : Party
    baseToken : Token
    quoteToken : Token
    lpToken : Token
  deriving (Eq, Show)

data DepositMode = InitializeOnly | Proportional
  deriving (Eq, Show)

data DepositTerms = DepositTerms with
    requestId : Text
    mode : DepositMode
    maxBaseAmount : Decimal
    maxQuoteAmount : Decimal
    minLpOut : Decimal
    minRatio : Decimal
    maxRatio : Decimal
    settlementDeadline : Time
  deriving (Eq, Show)

data WithdrawalTerms = WithdrawalTerms with
    requestId : Text
    lpAmount : Decimal
    minBaseOut : Decimal
    minQuoteOut : Decimal
    settlementDeadline : Time
  deriving (Eq, Show)

data DepositRequest pool = DepositRequest with
    poolCid : ContractId pool
    trader : Party
    terms : DepositTerms
    baseAllocation : ContractId A.Allocation
    quoteAllocation : ContractId A.Allocation
    lpAllocation : ContractId A.Allocation
  deriving (Eq, Show)

data WithdrawalRequest pool = WithdrawalRequest with
    poolCid : ContractId pool
    trader : Party
    terms : WithdrawalTerms
    baseAllocation : ContractId A.Allocation
    quoteAllocation : ContractId A.Allocation
    lpAllocation : ContractId A.Allocation
  deriving (Eq, Show)

data LiquidityTokenArgs = LiquidityTokenArgs with
    baseAllocationArgs : ExtraArgs
    quoteAllocationArgs : ExtraArgs
    lpAllocationArgs : ExtraArgs
    baseSettlementArgs : ExtraArgs
    quoteSettlementArgs : ExtraArgs
    lpSettlementArgs : ExtraArgs
  deriving (Eq, Show)

data DepositBatchRequest pool = DepositBatchRequest with
    request : DepositRequest pool
    tokenArgs : LiquidityTokenArgs
  deriving (Eq, Show)

data WithdrawalBatchRequest pool = WithdrawalBatchRequest with
    request : WithdrawalRequest pool
    tokenArgs : LiquidityTokenArgs
  deriving (Eq, Show)

data DepositOutcome = DepositOutcome with
    baseAmount : Decimal
    quoteAmount : Decimal
    baseRefund : Decimal
    quoteRefund : Decimal
    lpAmount : Decimal
  deriving (Eq, Show)

data WithdrawalOutcome = WithdrawalOutcome with
    baseAmount : Decimal
    quoteAmount : Decimal
    lpAmount : Decimal
  deriving (Eq, Show)

data LiquidityOutcome = LiquidityDeposited DepositOutcome | LiquidityWithdrawn WithdrawalOutcome
  deriving (Eq, Show)

-- | Encode deposit limits, mode and deadline into the ID shared by its three allocations.
depositId : DepositTerms -> Text
depositId t = "deposit:" <> t.requestId <> ":" <> show t.mode <> ":"
  <> Text.intercalate ":" (map amountText [t.maxBaseAmount, t.maxQuoteAmount, t.minLpOut, t.minRatio, t.maxRatio])
  <> ":" <> deadlineText t.settlementDeadline

-- | Encode LP input, minimum payouts and deadline into the ID shared by withdrawal allocations.
withdrawalId : WithdrawalTerms -> Text
withdrawalId t = "withdrawal:" <> t.requestId <> ":"
  <> Text.intercalate ":" (map amountText [t.lpAmount, t.minBaseOut, t.minQuoteOut])
  <> ":" <> deadlineText t.settlementDeadline

-- | Build settlement details linking the pool, encoded request terms and both required executors.
liquiditySettlement : LiquidityRoute pool -> Text -> A.SettlementInfo
liquiditySettlement route id = A.SettlementInfo with
  executors = [route.dvo, route.venueOperator]; id
  cid = Some (toAnyContractId route.poolCid); meta = emptyMetadata

-- | Reject liquidity requests from either executor so trader and pool roles remain distinct.
validateLiquidityTrader : LiquidityRoute pool -> Party -> Update ()
validateLiquidityTrader route trader =
  assertMsg "liquidity trader must differ from pool executors" (trader /= route.dvo && trader /= route.venueOperator)

-- | Reject invalid deposit limits, ratio bounds, token precision or expired deadlines.
validateDepositTerms : LiquidityRoute pool -> DepositTerms -> Update ()
validateDepositTerms route t = do
  assertMsg "invalid deposit terms" (t.requestId /= "" && t.maxBaseAmount > 0.0 && t.maxQuoteAmount > 0.0
    && t.minLpOut >= 0.0 && t.minRatio > 0.0 && t.maxRatio >= t.minRatio)
  assertMsg "invalid deposit precision" (quantized route.baseToken t.maxBaseAmount
    && quantized route.quoteToken t.maxQuoteAmount && quantized route.lpToken t.minLpOut)
  assertWithinDeadline "liquidity settlement deadline" t.settlementDeadline

-- | Require positive LP input, nonnegative minimum payouts, correct token precision and a live deadline.
validateWithdrawalTerms : LiquidityRoute pool -> WithdrawalTerms -> Update ()
validateWithdrawalTerms route t = do
  assertMsg "invalid withdrawal terms" (t.requestId /= "" && t.lpAmount > 0.0 && t.minBaseOut >= 0.0 && t.minQuoteOut >= 0.0)
  assertMsg "invalid withdrawal precision" (quantized route.lpToken t.lpAmount
    && quantized route.baseToken t.minBaseOut && quantized route.quoteToken t.minQuoteOut)
  assertWithinDeadline "liquidity settlement deadline" t.settlementDeadline

-- | Require a nonempty, bounded list of distinct holdings before reserving liquidity inputs.
validateLiquidityInputs : [ContractId H.Holding] -> Update ()
validateLiquidityInputs cids = assertMsg "invalid liquidity input holdings"
  (not (null cids) && length cids <= maxInputHoldings && length cids == length (dedup cids))

-- | Lock the trader's maximum base and quote deposits and authorize LP receipt under the same terms.
requestDeposit : LiquidityRoute pool -> Party -> DepositTerms -> Time
  -> [ContractId H.Holding] -> [ContractId H.Holding] -> ExtraArgs -> ExtraArgs -> ExtraArgs
  -> Update (DepositRequest pool)
requestDeposit route trader terms requestedAt baseInputs quoteInputs baseArgs quoteArgs lpArgs = do
  validateLiquidityTrader route trader
  validateDepositTerms route terms
  validateLiquidityInputs baseInputs
  validateLiquidityInputs quoteInputs
  assertMsg "deposit request time must precede deadline" (requestedAt < terms.settlementDeadline)
  let settlement = liquiditySettlement route (depositId terms)
      account = basicAccount trader
      deadline = terms.settlementDeadline
  (baseAllocation, _) <- allocate route.baseToken settlement account requestedAt deadline
    [] (iterationFunding route.baseToken terms.maxBaseAmount) emptyMetadata baseInputs baseArgs
  (quoteAllocation, _) <- allocate route.quoteToken settlement account requestedAt deadline
    [] (iterationFunding route.quoteToken terms.maxQuoteAmount) emptyMetadata quoteInputs quoteArgs
  (lpAllocation, _) <- allocate route.lpToken settlement account requestedAt deadline
    [] (iterationFunding route.lpToken 0.0) (minimumMetadata minLpOutKey terms.minLpOut) [] lpArgs
  pure DepositRequest with poolCid = route.poolCid; trader; terms; baseAllocation; quoteAllocation; lpAllocation

-- | Lock LP tokens for burning and authorize base/quote receipts with the trader's signed minimums.
requestWithdrawal : LiquidityRoute pool -> Party -> WithdrawalTerms -> Time
  -> [ContractId H.Holding] -> ExtraArgs -> ExtraArgs -> ExtraArgs -> Update (WithdrawalRequest pool)
requestWithdrawal route trader terms requestedAt lpInputs baseArgs quoteArgs lpArgs = do
  validateLiquidityTrader route trader
  validateWithdrawalTerms route terms
  validateLiquidityInputs lpInputs
  assertMsg "withdrawal request time must precede deadline" (requestedAt < terms.settlementDeadline)
  let settlement = liquiditySettlement route (withdrawalId terms)
      account = basicAccount trader
      deadline = terms.settlementDeadline
      lpLeg = transferLeg "lp-burn" account burnAccount route.lpToken terms.lpAmount
  (lpAllocation, _) <- allocate route.lpToken settlement account requestedAt deadline [senderSide lpLeg] None emptyMetadata lpInputs lpArgs
  (baseAllocation, _) <- allocate route.baseToken settlement account requestedAt deadline
    [] (iterationFunding route.baseToken 0.0) (minimumMetadata minBaseOutKey terms.minBaseOut) [] baseArgs
  (quoteAllocation, _) <- allocate route.quoteToken settlement account requestedAt deadline
    [] (iterationFunding route.quoteToken 0.0) (minimumMetadata minQuoteOutKey terms.minQuoteOut) [] quoteArgs
  pure WithdrawalRequest with poolCid = route.poolCid; trader; terms; baseAllocation; quoteAllocation; lpAllocation

-- | Calculate accepted deposits, refunds and LP output for an initial or proportional deposit.
-- Round proportional deposits up; exclude permanently locked LP shares from initial issuance.
depositAmounts : LiquidityRoute pool -> Decimal -> Decimal -> Decimal -> Decimal -> DepositTerms -> DepositOutcome
depositAmounts route initialRatio baseReserve quoteReserve supply t =
  let (base, quote, shares) =
        if supply == 0.0 then
          let initialBase = min t.maxBaseAmount
                (liquidityRatio route.baseToken.decimals Numeric.RoundingFloor t.maxQuoteAmount 1.0 initialRatio)
              initialQuote = liquidityRatio route.quoteToken.decimals Numeric.RoundingCeiling initialBase initialRatio 1.0
          in (initialBase, initialQuote, initialLpSupply initialBase initialQuote - minimumLiquidity)
        else
          let proportionalShares = min
                (liquidityRatio 10 Numeric.RoundingFloor t.maxBaseAmount supply baseReserve)
                (liquidityRatio 10 Numeric.RoundingFloor t.maxQuoteAmount supply quoteReserve)
          in ( liquidityRatio route.baseToken.decimals Numeric.RoundingCeiling proportionalShares baseReserve supply
             , liquidityRatio route.quoteToken.decimals Numeric.RoundingCeiling proportionalShares quoteReserve supply
             , proportionalShares )
  in DepositOutcome with
       baseAmount = base; quoteAmount = quote
       baseRefund = t.maxBaseAmount - base; quoteRefund = t.maxQuoteAmount - quote; lpAmount = shares

-- | Compute pro-rata reserve payouts for the LP burn, rounding down to each token's precision.
withdrawalAmounts : LiquidityRoute pool -> Decimal -> Decimal -> Decimal -> WithdrawalTerms -> WithdrawalOutcome
withdrawalAmounts route baseReserve quoteReserve supply t = WithdrawalOutcome with
  baseAmount = liquidityRatio route.baseToken.decimals Numeric.RoundingFloor t.lpAmount baseReserve supply
  quoteAmount = liquidityRatio route.quoteToken.decimals Numeric.RoundingFloor t.lpAmount quoteReserve supply
  lpAmount = t.lpAmount

-- | Enforce positive deposits, nonnegative refunds and the trader's minimum LP output.
-- Check the initial or current pool ratio against the trader's signed ratio bounds.
validateDepositAmounts : Decimal -> Decimal -> Decimal -> DepositTerms -> DepositOutcome -> Update ()
validateDepositAmounts initialRatio baseReserve quoteReserve terms result = do
  assertMsg "deposit amounts exceed signed limits" (result.baseAmount > 0.0 && result.quoteAmount > 0.0
    && result.baseRefund >= 0.0 && result.quoteRefund >= 0.0)
  assertMsg eDepositBelowMinimumOutput (result.lpAmount > 0.0 && result.lpAmount >= terms.minLpOut)
  let (ratioBase, ratioQuote) = if baseReserve == 0.0 then (1.0, initialRatio) else (baseReserve, quoteReserve)
  assertMsg "deposit ratio outside signed bounds"
    (Numeric.cast @20 ratioQuote >= Numeric.mul @20 ratioBase terms.minRatio
      && Numeric.cast @20 ratioQuote <= Numeric.mul @20 ratioBase terms.maxRatio)

-- | Settle one deposit token into the pool and return its updated reserve holdings.
-- Token settlement returns unused trader funding directly to the trader.
settleDepositAsset : Token -> H.Account -> Party -> A.SettlementInfo -> Time -> Text
  -> Decimal -> Decimal -> Decimal -> [ContractId H.Holding] -> ContractId A.Allocation
  -> ExtraArgs -> ExtraArgs -> Update [ContractId H.Holding]
settleDepositAsset token poolAccount trader settlement deadline label maximum amount reserve holdings traderAllocation allocationArgs settlementArgs = do
  let account = basicAccount trader
      input = transferLeg (label <> "-deposit") account poolAccount token amount
  checkAllocation token settlement account deadline [] (iterationFunding token maximum) emptyMetadata traderAllocation
  now <- getTime
  (poolAllocation, change) <- allocate token settlement poolAccount now deadline
    [] (iterationFunding token reserve) emptyMetadata holdings allocationArgs
  (_, received) <- settlePair token settlement [input] traderAllocation [senderSide input]
    poolAllocation [receiverSide input] settlementArgs
  pure (change <> received)

-- | Mint the quoted LP amount to the trader and verify the resulting holdings match it exactly.
settleMint : LiquidityRoute pool -> DepositRequest pool -> Decimal -> ExtraArgs -> ExtraArgs -> Update ()
settleMint route request amount allocationArgs settlementArgs = do
  let terms = request.terms
      account = basicAccount request.trader
      settlement = liquiditySettlement route (depositId terms)
      leg = transferLeg "lp-mint" mintAccount account route.lpToken amount
  checkAllocation route.lpToken settlement account terms.settlementDeadline
    [] (iterationFunding route.lpToken 0.0) (minimumMetadata minLpOutKey terms.minLpOut) request.lpAllocation
  now <- getTime
  (mintAllocation, _) <- allocate route.lpToken settlement mintAccount now terms.settlementDeadline
    [senderSide leg] None emptyMetadata [] allocationArgs
  (received, _) <- settlePair route.lpToken settlement [leg] request.lpAllocation [receiverSide leg] mintAllocation [] settlementArgs
  total <- holdingTotal route.lpToken account received
  assertMsg "LP mint delivery mismatch" (total == amount)

-- | Pay one reserve asset to the trader and return the holdings left in the pool.
-- Require the receive allocation to match the signed minimum output and settlement terms.
settleWithdrawalAsset : Token -> H.Account -> Party -> A.SettlementInfo -> Time -> Text -> Text
  -> Decimal -> Decimal -> Decimal -> [ContractId H.Holding] -> ContractId A.Allocation
  -> ExtraArgs -> ExtraArgs -> Update [ContractId H.Holding]
settleWithdrawalAsset token poolAccount trader settlement deadline label minimumKey minimum amount reserve holdings traderAllocation allocationArgs settlementArgs = do
  let account = basicAccount trader
      leg = transferLeg (label <> "-withdrawal") poolAccount account token amount
  checkAllocation token settlement account deadline [] (iterationFunding token 0.0)
    (minimumMetadata minimumKey minimum) traderAllocation
  now <- getTime
  (poolAllocation, change) <- allocate token settlement poolAccount now deadline []
    (iterationFunding token reserve) emptyMetadata holdings allocationArgs
  (_, retained) <- settlePair token settlement [leg] traderAllocation [receiverSide leg]
    poolAllocation [senderSide leg] settlementArgs
  pure (change <> retained)

-- | Burn the LP amount locked by the withdrawal request; reject any holdings returned by the burn.
settleBurn : LiquidityRoute pool -> WithdrawalRequest pool -> ExtraArgs -> ExtraArgs -> Update ()
settleBurn route request allocationArgs settlementArgs = do
  let terms = request.terms
      settlement = liquiditySettlement route (withdrawalId terms)
      account = basicAccount request.trader
      leg = transferLeg "lp-burn" account burnAccount route.lpToken terms.lpAmount
  checkAllocation route.lpToken settlement account terms.settlementDeadline [senderSide leg] None emptyMetadata request.lpAllocation
  now <- getTime
  (burnAllocation, _) <- allocate route.lpToken settlement burnAccount now terms.settlementDeadline [receiverSide leg] None emptyMetadata [] allocationArgs
  (received, retained) <- settlePair route.lpToken settlement [leg] request.lpAllocation [] burnAllocation [] settlementArgs
  assertMsg "LP burn produced holdings" (null received && null retained)
