-- | Pure constant-product pricing with conservative rounding.
module Lib.Math where

import Errors
import DA.Numeric qualified as Numeric

-- | Accept whole basis points in [0, 10000), so the input fee stays below 100%.
validFee : Decimal -> Bool
validFee feeBps = feeBps >= 0.0 && feeBps < 10000.0
  && Numeric.roundNumeric 0 Numeric.RoundingFloor feeBps == feeBps

-- | Check output precision, fee and positive amounts before pricing.
validSwapInputs : Int -> Decimal -> Decimal -> Decimal -> Decimal -> Bool
validSwapInputs outputScale feeBps reserveIn reserveOut amountIn =
  outputScale >= 0 && outputScale <= 10
    && validFee feeBps
    && all (> 0.0) [reserveIn, reserveOut, amountIn]

-- | Price a swap at Decimal precision (10 places), rounding the output down.
-- Arguments are fee basis points, input reserve, output reserve and input amount.
swapOutput : Decimal -> Decimal -> Decimal -> Decimal -> Decimal
swapOutput = swapOutputAtScale 10

-- | Price a swap after the input fee, rounding down to the output token precision.
-- Integer atoms preserve input precision; correct nearest-rounded division before
-- converting back so a result just below a quantum floors. Native numeric
-- overflow aborts the calculation if an intermediate exceeds 38 digits.
swapOutputAtScale : Int -> Decimal -> Decimal -> Decimal -> Decimal -> Decimal
swapOutputAtScale outputScale feeBps reserveIn reserveOut amountIn =
  if not (validSwapInputs outputScale feeBps reserveIn reserveOut amountIn)
  then error eInvalidSwapInputs
  else
    let inputAtoms = Numeric.shift @0 amountIn
        reserveInAtoms = Numeric.shift @0 reserveIn
        reserveOutAtoms = Numeric.shift @0 reserveOut
        feeMultiplier = 10000.0 - Numeric.cast @0 feeBps
        quantumAtoms = intToNumeric @0 (10 ^ (10 - outputScale))
        numerator = reserveOutAtoms * inputAtoms * feeMultiplier
        denominator = (reserveInAtoms * 10000.0 + inputAtoms * feeMultiplier) * quantumAtoms
        quanta = integerFloorDivision numerator denominator
    in Numeric.shift @10 (quanta * quantumAtoms)

-- | Liquidity uses ten-decimal LP shares; this supply remains permanently unredeemable.
minimumLiquidity : Decimal
minimumLiquidity = 0.0000001

-- | Atomic arithmetic rounds once to the output precision; overflow rejects the operation.
liquidityRatio : Int -> Numeric.RoundingMode -> Decimal -> Decimal -> Decimal -> Decimal
liquidityRatio decimals rounding amount numerator denominator =
  let top = Numeric.shift @0 amount * Numeric.shift @0 numerator
      quantum = intToNumeric @0 (10 ^ (10 - decimals))
      bottom = Numeric.shift @0 denominator * quantum
      floor = integerFloorDivision top bottom
      result = case rounding of
        Numeric.RoundingFloor -> floor
        Numeric.RoundingCeiling -> if floor * bottom < top then floor + 1.0 else floor
        _ -> error "unsupported liquidity rounding"
  in Numeric.shift @10 (result * quantum)

-- | Integer Newton iteration gives the exact floor, including the final quantum.
initialLpSupply : Decimal -> Decimal -> Decimal
initialLpSupply base quote =
  Numeric.shift @10 (integerSquareRoot (Numeric.shift @0 (Numeric.mul @20 base quote)))

-- | Nonnegative integer division. Start below the floor so its product cannot overflow.
integerFloorDivision : Numeric 0 -> Numeric 0 -> Numeric 0
integerFloorDivision top bottom =
  let candidate = max 0.0 (Numeric.div @0 top bottom - 1.0)
      remainder = top - candidate * bottom
  in if remainder >= bottom then candidate + 1.0 else candidate

integerSquareRoot : Numeric 0 -> Numeric 0
integerSquareRoot value
  | value < 0.0 = error "negative square root"
  | value < 2.0 = value
  | otherwise = squareRootStep value (integerFloorDivision value 2.0 + 1.0) 128

squareRootStep : Numeric 0 -> Numeric 0 -> Int -> Numeric 0
squareRootStep value current remaining =
  let next = integerFloorDivision (current + integerFloorDivision value current) 2.0
  in if next >= current then current
     else if remaining == 0 then error "square root iteration limit"
     else squareRootStep value next (remaining - 1)
