-- | Defines the pool, its fee and reserves, and receipts for completed swaps.
-- Connects reserves to token holdings and settles each swap batch as one transaction.
module Pool where

import Errors
import Splice.Api.Token.HoldingV2 (Account, InstrumentId)
import Lib.Math
import Lib.Tokens
import DA.Optional (isNone)
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.TokenStandard.Utils (basicAccount, toAnyContractId)
import DA.Assert (assertDeadlineExceeded)
import DA.List (dedup)
import Lib.Swap

data PoolFunding = PoolFunding with
    baseToken : Token
    quoteToken : Token
    baseHoldingCids : [ContractId H.Holding]
    quoteHoldingCids : [ContractId H.Holding]
  deriving (Eq, Show)

data BatchResult = BatchResult with
    stateCid : ContractId PoolState
    receiptCids : [ContractId SwapReceipt]
    amountsOut : [Decimal]
  deriving (Eq, Show)

-- | Records a completed swap and the allocations used to settle it.
template SwapReceipt
  with
    dvo : Party
    venueOperator : Party
    trader : Party
    poolCid : ContractId Pool
    inputAllocation : ContractId A.Allocation
    outputAllocation : ContractId A.Allocation
    batchId : Text
    terms : SwapTerms
    amountOut : Decimal
    settledAt : Time
  where
    signatory dvo, venueOperator
    observer trader

-- | Keeps the token pair and accounts, and handles funding, swaps and expired token locks.
template Pool
  with
    dvo : Party
    venueOperator : Party
    baseInstrumentId : InstrumentId
    quoteInstrumentId : InstrumentId
    baseAccount : Account
    quoteAccount : Account
    lpTokenInstrumentId : InstrumentId
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator
      && baseInstrumentId /= quoteInstrumentId
      && lpTokenInstrumentId.admin == dvo
      && baseAccount.owner == Some dvo
      && quoteAccount.owner == Some dvo

    -- | Settle an ordered batch atomically and replace the state once with its final backing.
    nonconsuming choice Pool_Swap : BatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [BatchRequest Pool]
        batchId : Text
      controller dvo, venueOperator
      do
        (config, state) <- loadComponents this self configCid stateCid
        funding <- requireFunding state
        validateBatch batchId requests
        let route = SwapRoute with
              poolCid = self; dvo; venueOperator
              baseToken = funding.baseToken; quoteToken = funding.quoteToken; baseAccount; quoteAccount
        validateBacking this state funding
        (next, nextFunding, receipts, amountsOut) <- settleRequests route config.feeBps batchId state funding requests
        validateBacking this next nextFunding
        archive stateCid
        nextCid <- create next with funding = Some nextFunding
        pure BatchResult with stateCid = nextCid; receiptCids = receipts; amountsOut

    -- | Return expired allocations to their trader without requiring current pool access.
    nonconsuming choice Pool_WithdrawSwap : [A.AllocationResult]
      with
        trader : Party
        withdrawals : [AllocationWithdrawal]
      controller trader
      do
        validateWithdrawals withdrawals
        forA withdrawals $ \withdrawal -> do
          allocation <- view <$> fetch withdrawal.allocationCid
          validateWithdrawal self trader allocation
          result <- exercise withdrawal.allocationCid A.Allocation_Withdraw with actors = [trader]; extraArgs = withdrawal.extraArgs
          requireWithdrawalComplete result
          pure result

    nonconsuming choice Pool_Fund : ContractId PoolState
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        funding : PoolFunding
      controller dvo
      do
        (_, state) <- loadComponents this self configCid stateCid
        validateInitialFunding this state funding
        archive stateCid
        create state with funding = Some funding

-- | Stores the swap fee, which the pool authority (dvo) can update.
template PoolConfig
  with
    poolCid : ContractId Pool
    dvo : Party
    venueOperator : Party
    feeBps : Decimal
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator && validFee feeBps

    choice PoolConfig_Update : ContractId PoolConfig
      with newFeeBps : Decimal
      controller dvo
      do
        requireValidFee newFeeBps
        create this with feeBps = newFeeBps

-- | Tracks the current reserves, recorded LP supply and token holdings backing the pool.
template PoolState
  with
    poolCid : ContractId Pool
    dvo : Party
    venueOperator : Party
    baseReserve : Decimal
    quoteReserve : Decimal
    lpTokenSupply : Decimal
    funding : Optional PoolFunding
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator
      && baseReserve > 0.0 && quoteReserve > 0.0 && lpTokenSupply > 0.0

-- | Require a named, bounded batch with no reused allocation.
validateBatch : Text -> [BatchRequest pool] -> Update ()
validateBatch batchId requests = do
  assertMsg eBatchIdRequired (batchId /= "")
  assertMsg eInvalidBatchSize (not (null requests) && length requests <= 20)
  let allocationCids = concatMap (\item -> [item.request.inputAllocation, item.request.outputAllocation]) requests
  assertMsg eDuplicateAllocation (length allocationCids == length (dedup allocationCids))

-- | Accept one or two distinct allocations for recovery.
validateWithdrawals : [AllocationWithdrawal] -> Update ()
validateWithdrawals withdrawals = do
  let allocationCids = map (.allocationCid) withdrawals
  assertMsg eInvalidWithdrawalSize (not (null allocationCids) && length allocationCids <= 2)
  assertMsg eDuplicateWithdrawalAllocation (length allocationCids == length (dedup allocationCids))

-- | The trader may recover only their expired allocations for this pool.
validateWithdrawal : ContractId Pool -> Party -> A.AllocationView -> Update ()
validateWithdrawal poolCid trader allocation = do
  assertMsg eWithdrawalAccountMismatch (allocation.allocation.authorizer == basicAccount trader)
  assertMsg eWithdrawalPoolMismatch (allocation.settlement.cid == Some (toAnyContractId poolCid))
  case allocation.allocation.settlementDeadline of
    Some deadline -> assertDeadlineExceeded allocationSettlementDeadlineLabel deadline
    None -> abort eWithdrawalDeadlineRequired

requireWithdrawalComplete : A.AllocationResult -> Update ()
requireWithdrawalComplete result =
  assertMsg eTokenWithdrawalIncomplete (result.output == A.AllocationResult_Withdrawn)

-- | Initial backing must match the unfunded pool's instruments and reserves.
validateInitialFunding : Pool -> PoolState -> PoolFunding -> Update ()
validateInitialFunding pool state funding = do
  assertMsg ePoolAlreadyFunded (isNone state.funding)
  assertMsg eFundingInstrumentMismatch
    (funding.baseToken.instrument == pool.baseInstrumentId && funding.quoteToken.instrument == pool.quoteInstrumentId)
  validateToken pool.dvo funding.baseToken
  validateToken pool.dvo funding.quoteToken
  validateBacking pool state funding

requireValidFee : Decimal -> Update ()
requireValidFee feeBps = assertMsg eInvalidFee (validFee feeBps)

-- | Load the current configuration and state, requiring the same pool and authority.
loadComponents : Pool -> ContractId Pool -> ContractId PoolConfig -> ContractId PoolState
  -> Update (PoolConfig, PoolState)
loadComponents pool poolCid configCid stateCid = do
  config <- fetch configCid
  state <- fetch stateCid
  assertMsg eConfigurationPoolMismatch (config.poolCid == poolCid)
  assertMsg eStatePoolMismatch (state.poolCid == poolCid)
  assertMsg eConfigurationAuthorityMismatch
    (config.dvo == pool.dvo && config.venueOperator == pool.venueOperator)
  assertMsg eStateAuthorityMismatch
    (state.dvo == pool.dvo && state.venueOperator == pool.venueOperator)
  pure (config, state)

-- | Require token backing before settlement.
requireFunding : PoolState -> Update PoolFunding
requireFunding state = case state.funding of
  Some funding -> pure funding
  None -> abort ePoolNotFunded

-- | Verify that the actual holdings exactly match both recorded reserves.
validateBacking : Pool -> PoolState -> PoolFunding -> Update ()
validateBacking pool state funding = do
  baseTotal <- holdingTotal funding.baseToken pool.baseAccount funding.baseHoldingCids
  quoteTotal <- holdingTotal funding.quoteToken pool.quoteAccount funding.quoteHoldingCids
  assertMsg eBaseReserveNotBacked (baseTotal == state.baseReserve)
  assertMsg eQuoteReserveNotBacked (quoteTotal == state.quoteReserve)

-- | Price each request against the previous result and collect receipts; leave state replacement to Pool_Swap.
settleRequests : SwapRoute Pool -> Decimal -> Text -> PoolState -> PoolFunding -> [BatchRequest Pool]
  -> Update (PoolState, PoolFunding, [ContractId SwapReceipt], [Decimal])
settleRequests _ _ _ state funding [] = pure (state, funding, [], [])
settleRequests route feeBps batchId state funding (item :: rest) = do
  result <- settleRequest route feeBps state.baseReserve state.quoteReserve funding.baseHoldingCids funding.quoteHoldingCids item
  settledAt <- getTime
  let request = item.request
  receipt <- create SwapReceipt with
    dvo = route.dvo; venueOperator = route.venueOperator; trader = request.trader; poolCid = route.poolCid
    inputAllocation = request.inputAllocation; outputAllocation = request.outputAllocation
    batchId; terms = request.terms; amountOut = result.amountOut; settledAt
  let nextState = state with baseReserve = result.baseReserve; quoteReserve = result.quoteReserve
      nextFunding = funding with baseHoldingCids = result.baseHoldingCids; quoteHoldingCids = result.quoteHoldingCids
  (finalState, finalFunding, receipts, amounts) <- settleRequests route feeBps batchId nextState nextFunding rest
  pure (finalState, finalFunding, receipt :: receipts, result.amountOut :: amounts)
