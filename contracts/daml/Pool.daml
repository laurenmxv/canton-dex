-- | Defines the pool, its fee and reserves, and receipts for swaps and liquidity.
module Pool where

import Errors
import Splice.Api.Token.HoldingV2 (Account)
import Lib.Math
import Lib.Tokens
import Lib.Liquidity
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import DA.List (dedup)
import Lib.Swap

data SwapBatchResult = SwapBatchResult with
    stateCid : ContractId PoolState
    receiptCids : [ContractId SwapReceipt]
    amountsOut : [Decimal]
  deriving (Eq, Show)

-- | Records a completed swap and the allocations used to settle it.
template SwapReceipt
  with
    dvo : Party
    venueOperator : Party
    trader : Party
    poolCid : ContractId Pool
    inputAllocation : ContractId A.Allocation
    outputAllocation : ContractId A.Allocation
    batchId : Text
    terms : SwapTerms
    amountOut : Decimal
    settledAt : Time
  where
    signatory dvo, venueOperator
    observer trader

-- | Keeps the token pair and accounts, and settles swaps and liquidity.
template Pool
  with
    dvo : Party
    venueOperator : Party
    baseToken : Token
    quoteToken : Token
    lpToken : Token
    baseAccount : Account
    quoteAccount : Account
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator
      && baseToken.instrument /= quoteToken.instrument
      && lpToken.instrument.admin == dvo
      && lpToken.decimals == 10
      && lpToken.instrument /= baseToken.instrument
      && lpToken.instrument /= quoteToken.instrument
      && baseAccount.owner == Some dvo
      && quoteAccount.owner == Some dvo
      && baseAccount.provider == Some venueOperator
      && quoteAccount.provider == Some venueOperator
      && baseAccount /= quoteAccount

    -- | Settle an ordered batch atomically and replace the state once with its final backing.
    nonconsuming choice Pool_Swap : SwapBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [BatchRequest Pool]
        batchId : Text
      controller dvo, venueOperator
      do
        (config, state) <- loadComponents this self configCid stateCid
        assertMsg ePoolNotFunded (state.lpTokenSupply > 0.0)
        validateBatch batchId requests
        let route = SwapRoute with
              poolCid = self; dvo; venueOperator
              baseToken; quoteToken; baseAccount; quoteAccount
        validateBacking this state
        (next, receipts, amountsOut) <- settleRequests route config.feeBps batchId state requests
        validateBacking this next
        archive stateCid
        nextCid <- create next
        pure SwapBatchResult with stateCid = nextCid; receiptCids = receipts; amountsOut

    -- | Settle deposits atomically, mint LP tokens and replace the reserve state.
    nonconsuming choice Pool_AddLiquidity : AddLiquidityBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [DepositBatchRequest Pool]
      controller dvo, venueOperator
      do
        (config, state) <- loadComponents this self configCid stateCid
        validateDepositBatch requests
        validateBacking this state
        (next, receipts, outcomes) <- settleDeposits this self config.initialRatio state requests
        archive stateCid
        nextCid <- create next
        pure AddLiquidityBatchResult with stateCid = nextCid; receiptCids = receipts; outcomes

    -- | Settle withdrawals atomically, burn LP tokens and return the underlying assets.
    nonconsuming choice Pool_WithdrawLiquidity : WithdrawLiquidityBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [WithdrawalBatchRequest Pool]
      controller dvo, venueOperator
      do
        (_, state) <- loadComponents this self configCid stateCid
        validateWithdrawalBatch requests
        validateBacking this state
        (next, receipts, outcomes) <- settleWithdrawals this self state requests
        archive stateCid
        nextCid <- create next
        pure WithdrawLiquidityBatchResult with stateCid = nextCid; receiptCids = receipts; outcomes

-- | Stores the swap fee, which the pool authority (dvo) can update.
template PoolConfig
  with
    poolCid : ContractId Pool
    dvo : Party
    venueOperator : Party
    feeBps : Decimal
    initialRatio : Decimal
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator && validFee feeBps && initialRatio > 0.0

    -- | Replace the configuration with a valid swap fee chosen by dvo.
    choice PoolConfig_Update : ContractId PoolConfig
      with newFeeBps : Decimal
      controller dvo
      do
        requireValidFee newFeeBps
        create this with feeBps = newFeeBps

-- | Tracks the current reserves, recorded LP supply and token holdings backing the pool.
template PoolState
  with
    poolCid : ContractId Pool
    dvo : Party
    venueOperator : Party
    baseReserve : Decimal
    quoteReserve : Decimal
    lpTokenSupply : Decimal
    baseHoldingCids : [ContractId H.Holding]
    quoteHoldingCids : [ContractId H.Holding]
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator
      && ((baseReserve == 0.0 && quoteReserve == 0.0 && lpTokenSupply == 0.0
          && null baseHoldingCids && null quoteHoldingCids)
        || (baseReserve > 0.0 && quoteReserve > 0.0 && lpTokenSupply >= minimumLiquidity))

-- | Cap the number of requests settled atomically in one pool transaction.
maxSettlementBatchSize : Int
maxSettlementBatchSize = 20

-- | Require a named, bounded batch with no reused allocation.
validateBatch : Text -> [BatchRequest pool] -> Update ()
validateBatch batchId requests = do
  assertMsg eBatchIdRequired (batchId /= "")
  assertMsg eInvalidBatchSize (not (null requests) && length requests <= maxSettlementBatchSize)
  let allocationCids = concatMap (\item -> [item.request.inputAllocation, item.request.outputAllocation]) requests
  assertMsg eDuplicateAllocation (length allocationCids == length (dedup allocationCids))

-- | Reject empty or oversized batches and reused allocations; an initial deposit must settle alone.
validateDepositBatch : [DepositBatchRequest pool] -> Update ()
validateDepositBatch requests = do
  assertMsg eInvalidBatchSize (not (null requests) && length requests <= maxSettlementBatchSize)
  assertMsg eInitialLiquidityBatch
    (length requests == 1 || all (\item -> item.request.terms.mode == Proportional) requests)
  let allocationCids = concatMap (\item ->
        [item.request.baseAllocation, item.request.quoteAllocation, item.request.lpAllocation]) requests
  assertMsg eDuplicateAllocation (length allocationCids == length (dedup allocationCids))

-- | Require a nonempty, bounded withdrawal batch with no allocation reused across requests or legs.
validateWithdrawalBatch : [WithdrawalBatchRequest pool] -> Update ()
validateWithdrawalBatch requests = do
  assertMsg eInvalidBatchSize (not (null requests) && length requests <= maxSettlementBatchSize)
  let allocationCids = concatMap (\item ->
        [item.request.baseAllocation, item.request.quoteAllocation, item.request.lpAllocation]) requests
  assertMsg eDuplicateAllocation (length allocationCids == length (dedup allocationCids))

-- | Reject swap fees outside the allowed whole-basis-point range before replacing the configuration.
requireValidFee : Decimal -> Update ()
requireValidFee feeBps = assertMsg eInvalidFee (validFee feeBps)

-- | Load the current configuration and state, requiring the same pool and authority.
loadComponents : Pool -> ContractId Pool -> ContractId PoolConfig -> ContractId PoolState
  -> Update (PoolConfig, PoolState)
loadComponents pool poolCid configCid stateCid = do
  config <- fetch configCid
  state <- fetch stateCid
  assertMsg eConfigurationPoolMismatch (config.poolCid == poolCid)
  assertMsg eStatePoolMismatch (state.poolCid == poolCid)
  assertMsg eConfigurationAuthorityMismatch
    (config.dvo == pool.dvo && config.venueOperator == pool.venueOperator)
  assertMsg eStateAuthorityMismatch
    (state.dvo == pool.dvo && state.venueOperator == pool.venueOperator)
  pure (config, state)

-- | Verify that the actual holdings exactly match both recorded reserves.
validateBacking : Pool -> PoolState -> Update ()
validateBacking pool state = do
  baseTotal <- holdingTotal pool.baseToken pool.baseAccount state.baseHoldingCids
  quoteTotal <- holdingTotal pool.quoteToken pool.quoteAccount state.quoteHoldingCids
  assertMsg eBaseReserveNotBacked (baseTotal == state.baseReserve)
  assertMsg eQuoteReserveNotBacked (quoteTotal == state.quoteReserve)

-- | Price each request against the previous result and collect receipts; leave state replacement to Pool_Swap.
settleRequests : SwapRoute Pool -> Decimal -> Text -> PoolState -> [BatchRequest Pool]
  -> Update (PoolState, [ContractId SwapReceipt], [Decimal])
settleRequests _ _ _ state [] = pure (state, [], [])
settleRequests route feeBps batchId state (item :: rest) = do
  result <- settleRequest route feeBps state.baseReserve state.quoteReserve state.baseHoldingCids state.quoteHoldingCids item
  settledAt <- getTime
  let request = item.request
  receipt <- create SwapReceipt with
    dvo = route.dvo; venueOperator = route.venueOperator; trader = request.trader; poolCid = route.poolCid
    inputAllocation = request.inputAllocation; outputAllocation = request.outputAllocation
    batchId; terms = request.terms; amountOut = result.amountOut; settledAt
  let nextState = state with
        baseReserve = result.baseReserve; quoteReserve = result.quoteReserve
        baseHoldingCids = result.baseHoldingCids; quoteHoldingCids = result.quoteHoldingCids
  (finalState, receipts, amounts) <- settleRequests route feeBps batchId nextState rest
  pure (finalState, receipt :: receipts, result.amountOut :: amounts)

-- | Both liquidity paths expose the same durable settlement evidence.
template LiquidityReceipt
  with
    dvo : Party
    venueOperator : Party
    trader : Party
    poolCid : ContractId Pool
    requestId : Text
    outcome : LiquidityOutcome
    settledAt : Time
  where
    signatory dvo, venueOperator
    observer trader

data WithdrawLiquidityBatchResult = WithdrawLiquidityBatchResult with
    stateCid : ContractId PoolState
    receiptCids : [ContractId LiquidityReceipt]
    outcomes : [WithdrawalOutcome]
  deriving (Eq, Show)

data AddLiquidityBatchResult = AddLiquidityBatchResult with
    stateCid : ContractId PoolState
    receiptCids : [ContractId LiquidityReceipt]
    outcomes : [DepositOutcome]
  deriving (Eq, Show)

-- | Settle deposits in order, mint LP tokens and record receipts against the updated reserves.
-- The caller persists the final state; the first deposit also locks the minimum LP supply.
settleDeposits : Pool -> ContractId Pool -> Decimal -> PoolState -> [DepositBatchRequest Pool]
  -> Update (PoolState, [ContractId LiquidityReceipt], [DepositOutcome])
settleDeposits _ _ _ state [] = pure (state, [], [])
settleDeposits pool poolCid initialRatio state (item :: rest) = do
  let route = liquidityRoute pool poolCid
      request = item.request
      terms = request.terms
      tokenArgs = item.tokenArgs
      initial = state.lpTokenSupply == 0.0
  assertMsg "deposit pool mismatch" (request.poolCid == poolCid)
  validateLiquidityTrader route request.trader
  validateDepositTerms route terms
  assertMsg "deposit mode does not match pool state" ((terms.mode == InitializeOnly) == initial)
  let outcome = depositAmounts route initialRatio state.baseReserve state.quoteReserve state.lpTokenSupply terms
      settlement = liquiditySettlement route (depositId terms)
  validateDepositAmounts initialRatio state.baseReserve state.quoteReserve terms outcome
  baseHoldingCids <- settleDepositAsset pool.baseToken pool.baseAccount request.trader settlement terms.settlementDeadline "base"
    terms.maxBaseAmount outcome.baseAmount state.baseReserve state.baseHoldingCids request.baseAllocation
    tokenArgs.baseAllocationArgs tokenArgs.baseSettlementArgs
  quoteHoldingCids <- settleDepositAsset pool.quoteToken pool.quoteAccount request.trader settlement terms.settlementDeadline "quote"
    terms.maxQuoteAmount outcome.quoteAmount state.quoteReserve state.quoteHoldingCids request.quoteAllocation
    tokenArgs.quoteAllocationArgs tokenArgs.quoteSettlementArgs
  settleMint route request outcome.lpAmount tokenArgs.lpAllocationArgs tokenArgs.lpSettlementArgs
  let next = state with
        baseReserve = state.baseReserve + outcome.baseAmount
        quoteReserve = state.quoteReserve + outcome.quoteAmount
        lpTokenSupply = state.lpTokenSupply + outcome.lpAmount + (if initial then minimumLiquidity else 0.0)
        baseHoldingCids; quoteHoldingCids
  validateBacking pool next
  settledAt <- getTime
  receipt <- create LiquidityReceipt with
    dvo = pool.dvo; venueOperator = pool.venueOperator; trader = request.trader; poolCid
    requestId = terms.requestId; outcome = LiquidityDeposited outcome; settledAt
  (finalState, receipts, outcomes) <- settleDeposits pool poolCid initialRatio next rest
  pure (finalState, receipt :: receipts, outcome :: outcomes)

-- | Pass the pool identity, settlement parties and three token configurations to liquidity helpers.
liquidityRoute : Pool -> ContractId Pool -> LiquidityRoute Pool
liquidityRoute pool poolCid = LiquidityRoute with
  poolCid; dvo = pool.dvo; venueOperator = pool.venueOperator
  baseToken = pool.baseToken; quoteToken = pool.quoteToken; lpToken = pool.lpToken

-- | Settle withdrawals in order, pay out reserves, burn LP tokens and record receipts.
-- Keep the minimum LP supply locked and return the final state for the caller to persist.
settleWithdrawals : Pool -> ContractId Pool -> PoolState -> [WithdrawalBatchRequest Pool]
  -> Update (PoolState, [ContractId LiquidityReceipt], [WithdrawalOutcome])
settleWithdrawals _ _ state [] = pure (state, [], [])
settleWithdrawals pool poolCid state (item :: rest) = do
  let route = liquidityRoute pool poolCid
      request = item.request
      terms = request.terms
      tokenArgs = item.tokenArgs
  assertMsg "withdrawal pool mismatch" (request.poolCid == poolCid)
  validateLiquidityTrader route request.trader
  validateWithdrawalTerms route terms
  assertMsg "withdrawal exceeds circulating LP supply" (terms.lpAmount <= state.lpTokenSupply - minimumLiquidity)
  let outcome = withdrawalAmounts route state.baseReserve state.quoteReserve state.lpTokenSupply terms
      settlement = liquiditySettlement route (withdrawalId terms)
  assertMsg eWithdrawalBelowMinimumOutput (outcome.baseAmount > 0.0 && outcome.quoteAmount > 0.0
    && outcome.baseAmount >= terms.minBaseOut && outcome.quoteAmount >= terms.minQuoteOut)
  baseHoldingCids <- settleWithdrawalAsset pool.baseToken pool.baseAccount request.trader settlement terms.settlementDeadline "base" minBaseOutKey
    terms.minBaseOut outcome.baseAmount state.baseReserve state.baseHoldingCids request.baseAllocation
    tokenArgs.baseAllocationArgs tokenArgs.baseSettlementArgs
  quoteHoldingCids <- settleWithdrawalAsset pool.quoteToken pool.quoteAccount request.trader settlement terms.settlementDeadline "quote" minQuoteOutKey
    terms.minQuoteOut outcome.quoteAmount state.quoteReserve state.quoteHoldingCids request.quoteAllocation
    tokenArgs.quoteAllocationArgs tokenArgs.quoteSettlementArgs
  settleBurn route request tokenArgs.lpAllocationArgs tokenArgs.lpSettlementArgs
  let next = state with
        baseReserve = state.baseReserve - outcome.baseAmount
        quoteReserve = state.quoteReserve - outcome.quoteAmount
        lpTokenSupply = state.lpTokenSupply - outcome.lpAmount
        baseHoldingCids; quoteHoldingCids
  validateBacking pool next
  settledAt <- getTime
  receipt <- create LiquidityReceipt with
    dvo = pool.dvo; venueOperator = pool.venueOperator; trader = request.trader; poolCid
    requestId = terms.requestId; outcome = LiquidityWithdrawn outcome; settledAt
  (finalState, receipts, outcomes) <- settleWithdrawals pool poolCid next rest
  pure (finalState, receipt :: receipts, outcome :: outcomes)
