-- https://github.com/Moonsong-Labs/canton-vaults/tree/main/patterns/01-vault-access

-- | Authorizes trader operations in one pool while access and KYC remain active.
module PoolAccess where

import Errors
import KycAttestation
import Pool
import Lib.Liquidity
import Lib.Swap
import Lib.Tokens
import DA.Assert (assertWithinDeadline, assertDeadlineExceeded)
import DA.List (dedup)
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.MetadataV1 (ExtraArgs, emptyMetadata)
import Splice.TokenStandard.Utils (basicAccount, toAnyContractId)

-- | Links a trader's pool access to the operator's KYC approval.
template PoolAccess
  with
    venueOperator : Party
    trader : Party
    poolCid : ContractId Pool
    attestationCid : ContractId KycAttestation
  where
    signatory venueOperator
    observer trader

    -- | Check access, reserve the swap input and create its output allocation.
    nonconsuming choice PoolAccess_RequestSwap : SwapRequest Pool
      with
        route : SwapRoute Pool
        terms : SwapTerms
        requestedAt : Time
        inputHoldingCids : [ContractId H.Holding]
        inputAllocationArgs : ExtraArgs
        outputAllocationArgs : ExtraArgs
      controller trader
      do
        validateSwapRequest this route terms requestedAt inputHoldingCids
        let (inputToken, outputToken, _, _) = directionRoute route terms.direction
            settlement = swapSettlement route terms
        (inputAllocation, _) <- allocate inputToken settlement (basicAccount trader)
          requestedAt terms.settlementDeadline [] (iterationFunding inputToken terms.amountIn)
          (minimumMetadata minOutKey terms.minOut) inputHoldingCids inputAllocationArgs
        (outputAllocation, _) <- allocate outputToken settlement (basicAccount trader)
          requestedAt terms.settlementDeadline [] (iterationFunding outputToken 0.0) emptyMetadata [] outputAllocationArgs
        pure SwapRequest with poolCid; trader; terms; inputAllocation; outputAllocation

    -- | Check access, reserve both deposit tokens and create the LP output allocation.
    nonconsuming choice PoolAccess_RequestLiquidityDeposit : DepositRequest Pool
      with
        terms : DepositTerms
        requestedAt : Time
        baseHoldingCids : [ContractId H.Holding]
        quoteHoldingCids : [ContractId H.Holding]
        baseAllocationArgs : ExtraArgs
        quoteAllocationArgs : ExtraArgs
        lpAllocationArgs : ExtraArgs
      controller trader
      do
        pool <- validatePoolAccess this
        requestDeposit (liquidityRoute pool poolCid) trader terms requestedAt baseHoldingCids quoteHoldingCids
          baseAllocationArgs quoteAllocationArgs lpAllocationArgs

    -- | Check access, reserve LP tokens and create the base and quote output allocations.
    nonconsuming choice PoolAccess_RequestLiquidityWithdrawal : WithdrawalRequest Pool
      with
        terms : WithdrawalTerms
        requestedAt : Time
        lpHoldingCids : [ContractId H.Holding]
        baseAllocationArgs : ExtraArgs
        quoteAllocationArgs : ExtraArgs
        lpAllocationArgs : ExtraArgs
      controller trader
      do
        pool <- validatePoolAccess this
        requestWithdrawal (liquidityRoute pool poolCid) trader terms requestedAt lpHoldingCids
          baseAllocationArgs quoteAllocationArgs lpAllocationArgs

    -- | Recover the trader's expired allocations for this pool while access and KYC remain active.
    nonconsuming choice PoolAccess_RecoverAllocations : [A.AllocationResult]
      with withdrawals : [AllocationWithdrawal]
      controller trader
      do
        _ <- validatePoolAccess this
        validateWithdrawalList withdrawals
        forA withdrawals $ \withdrawal -> do
          allocation <- view <$> fetch withdrawal.allocationCid
          validateWithdrawal poolCid trader allocation
          result <- exercise withdrawal.allocationCid A.Allocation_Withdraw with
            actors = [trader]; extraArgs = withdrawal.extraArgs
          requireWithdrawalComplete result
          pure result

-- | Return the pool after confirming active KYC and a matching access-granting operator.
validatePoolAccess : PoolAccess -> Update Pool
validatePoolAccess access = do
  validateAttestation access
  pool <- fetch access.poolCid
  assertMsg eAccessRequestMismatch (pool.venueOperator == access.venueOperator)
  pure pool

-- | Require at least one allocation to recover and reject duplicate IDs before withdrawing any funds.
validateWithdrawalList : [AllocationWithdrawal] -> Update ()
validateWithdrawalList withdrawals = do
  let allocationCids = map (.allocationCid) withdrawals
  assertMsg eInvalidWithdrawalSize (not (null allocationCids))
  assertMsg eDuplicateWithdrawalAllocation (length allocationCids == length (dedup allocationCids))

-- | The trader may recover only their expired allocations for this pool.
validateWithdrawal : ContractId Pool -> Party -> A.AllocationView -> Update ()
validateWithdrawal poolCid trader allocation = do
  assertMsg eWithdrawalAccountMismatch (allocation.allocation.authorizer == basicAccount trader)
  assertMsg eWithdrawalPoolMismatch (allocation.settlement.cid == Some (toAnyContractId poolCid))
  case allocation.allocation.settlementDeadline of
    Some deadline -> assertDeadlineExceeded allocationSettlementDeadlineLabel deadline
    None -> abort eWithdrawalDeadlineRequired

-- | Abort recovery unless the token implementation confirms that the allocation was withdrawn.
requireWithdrawalComplete : A.AllocationResult -> Update ()
requireWithdrawalComplete result =
  assertMsg eTokenWithdrawalIncomplete (result.output == A.AllocationResult_Withdrawn)

-- | Check access, route, timing and token amounts before locking any input.
validateSwapRequest : PoolAccess -> SwapRoute Pool -> SwapTerms -> Time -> [ContractId H.Holding] -> Update ()
validateSwapRequest access route terms requestedAt inputHoldingCids = do
  validateAttestation access
  assertMsg eSwapRouteMismatch (route.poolCid == access.poolCid && route.venueOperator == access.venueOperator)
  assertMsg eInvalidSwapTerms (validTerms terms && requestedAt < terms.settlementDeadline)
  requireTraderDistinct route access.trader
  assertMsg eSwapInputHoldingLimit (length inputHoldingCids <= maxInputHoldings)
  assertWithinDeadline settlementDeadlineLabel terms.settlementDeadline
  validateToken access.trader route.baseToken
  validateToken access.trader route.quoteToken
  let (inputToken, outputToken, _, _) = directionRoute route terms.direction
  assertMsg eInvalidInputAmount (quantized inputToken terms.amountIn)
  assertMsg eInvalidMinimumOutput (quantized outputToken terms.minOut)

-- | Before accepting a request, check that its KYC attestation is still active,
-- was issued by this operator, and covers this trader and pool.
validateAttestation : PoolAccess -> Update ()
validateAttestation access = do
  attestation <- fetch access.attestationCid
  assertMsg eKycIssuerMismatch (attestation.venueOperator == access.venueOperator)
  assertMsg eKycTraderMismatch (attestation.trader == access.trader)
  assertMsg eKycPoolMismatch (access.poolCid `elem` attestation.pools)
