-- | Creates pools from operator proposals accepted by the pool authority (dvo).
module PoolFactory where

import Errors
import Splice.Api.Token.HoldingV2 (Account(..), InstrumentId(..))
import Pool
import Lib.Tokens
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.AllocationInstructionV2 qualified as AI
import Lib.Math (validFee)

data PoolSettings = PoolSettings with
    dvo : Party
    poolId : Text
    baseToken : Token
    quoteToken : Token
    lpAllocationFactory : ContractId AI.AllocationFactory
    lpSettlementFactory : ContractId A.SettlementFactory
    feeBps : Decimal
  deriving (Eq, Show)

data PoolContracts = PoolContracts with
    poolCid : ContractId Pool
    configCid : ContractId PoolConfig
    stateCid : ContractId PoolState
  deriving (Eq, Show)

-- | Checks settings and creates the pool, fee configuration and initial state together.
template PoolFactory
  with
    dvo : Party
    venueOperator : Party
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator

    -- | Validate the operator's pool settings and submit them for dvo approval.
    nonconsuming choice PoolFactory_ProposePool : ContractId PoolProposal
      with settings : PoolSettings
      controller venueOperator
      do
        requirePoolSettings dvo settings
        create PoolProposal with
          factoryCid = self
          venueOperator
          settings
          accepted = False
          initialRatio = None

    -- | Consume an accepted proposal and create the pool, configuration and empty reserve state.
    nonconsuming choice PoolFactory_CreatePool : PoolContracts
      with proposalCid : ContractId PoolProposal
      controller dvo, venueOperator
      do
        proposal <- fetch proposalCid
        assertMsg ePoolProposalNotAccepted proposal.accepted
        assertMsg eFactoryProposalMismatch (proposal.factoryCid == self)
        assertMsg eFactoryOperatorMismatch (proposal.venueOperator == venueOperator)
        let settings = proposal.settings
        requirePoolSettings dvo settings
        archive proposalCid
        let lpToken = Token with
              instrument = InstrumentId with admin = dvo; id = "lp:" <> settings.poolId
              allocationFactory = settings.lpAllocationFactory
              settlementFactory = settings.lpSettlementFactory
              decimals = 10
        validateToken dvo settings.baseToken
        validateToken dvo settings.quoteToken
        validateToken dvo lpToken
        initialRatio <- case proposal.initialRatio of
          Some ratio -> pure ratio
          None -> abort "accepted proposal requires an initial ratio"
        poolCid <- create Pool with
          dvo; venueOperator
          baseToken = settings.baseToken; quoteToken = settings.quoteToken; lpToken
          baseAccount = Account with owner = Some dvo; provider = Some venueOperator; id = "base:" <> settings.poolId
          quoteAccount = Account with owner = Some dvo; provider = Some venueOperator; id = "quote:" <> settings.poolId
        configCid <- create PoolConfig with
          poolCid
          dvo
          venueOperator
          feeBps = settings.feeBps
          initialRatio
        stateCid <- create PoolState with
          poolCid
          dvo
          venueOperator
          baseReserve = 0.0
          quoteReserve = 0.0
          lpTokenSupply = 0.0
          baseHoldingCids = []
          quoteHoldingCids = []
        pure PoolContracts with poolCid; configCid; stateCid

-- | Holds the operator's proposed pool settings for dvo to accept or reject.
template PoolProposal
  with
    factoryCid : ContractId PoolFactory
    venueOperator : Party
    settings : PoolSettings
    accepted : Bool
    initialRatio : Optional Decimal
  where
    signatory venueOperator :: (if accepted then [settings.dvo] else [])
    observer settings.dvo
    ensure validSettings settings && settings.dvo /= venueOperator
      && (if accepted then optional False (> 0.0) initialRatio else initialRatio == None)

    -- | Accept the proposal at dvo's chosen ratio and create the pool.
    choice PoolProposal_Accept : PoolContracts
      with initialRatio : Decimal
      controller settings.dvo
      do
        assertMsg ePoolProposalAlreadyAccepted (not accepted)
        validateProposalFactory this
        assertMsg "initial ratio must be positive" (initialRatio > 0.0)
        proposalCid <- create this with accepted = True; initialRatio = Some initialRatio
        exercise factoryCid PoolFactory_CreatePool with proposalCid

    -- | Let dvo discard a pending proposal.
    choice PoolProposal_Reject : ()
      controller settings.dvo
      do assertMsg ePoolProposalAlreadyAccepted (not accepted)

    -- | Let the operator cancel a pending proposal.
    choice PoolProposal_Withdraw : ()
      controller venueOperator
      do assertMsg ePoolProposalAlreadyAccepted (not accepted)

-- | Reject a proposal whose dvo differs from the factory's pool authority.
requireFactoryAuthority : Party -> Party -> Update ()
requireFactoryAuthority expected actual =
  assertMsg eFactoryAuthorityMismatch (actual == expected)

-- | Require the factory's dvo and valid pool settings before proposing or creating a pool.
requirePoolSettings : Party -> PoolSettings -> Update ()
requirePoolSettings dvo settings = do
  requireFactoryAuthority dvo settings.dvo
  assertMsg eInvalidPoolSettings (validSettings settings)

-- | Acceptance must use the factory approved by both the operator and DVO.
validateProposalFactory : PoolProposal -> Update ()
validateProposalFactory proposal = do
  factory <- fetch proposal.factoryCid
  assertMsg eFactoryOperatorMismatch (factory.venueOperator == proposal.venueOperator)
  requireFactoryAuthority factory.dvo proposal.settings.dvo

-- | Check that the pool has a nonempty ID, distinct instruments, an allowed fee and supported token precision.
validSettings : PoolSettings -> Bool
validSettings settings =
  settings.poolId /= "" && settings.baseToken.instrument /= settings.quoteToken.instrument
    && validFee settings.feeBps
    && all (\token -> token.decimals >= 0 && token.decimals <= 10) [settings.baseToken, settings.quoteToken]
