-- | Creates pools with approval from the pool authority (dvo).
-- The operator can propose the settings; token backing is added separately.
module PoolFactory where

import Splice.Api.Token.HoldingV2 (Account, InstrumentId)
import Pool
import Lib.Math (validFee)

data PoolSettings = PoolSettings with
    dvo : Party
    baseInstrumentId : InstrumentId
    quoteInstrumentId : InstrumentId
    baseAccount : Account
    quoteAccount : Account
    lpTokenInstrumentId : InstrumentId
    feeBps : Decimal
    baseReserve : Decimal
    quoteReserve : Decimal
    lpTokenSupply : Decimal
  deriving (Eq, Show)

data PoolContracts = PoolContracts with
    poolCid : ContractId Pool
    configCid : ContractId PoolConfig
    stateCid : ContractId PoolState
  deriving (Eq, Show)

-- | Checks settings and creates the pool, fee configuration and initial state together.
template PoolFactory
  with
    dvo : Party
    venueOperator : Party
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator

    nonconsuming choice PoolFactory_ProposePool : ContractId PoolProposal
      with settings : PoolSettings
      controller venueOperator
      do
        assertMsg "Factory authority mismatch" (settings.dvo == dvo)
        assertMsg "Invalid pool settings" (validSettings settings)
        create PoolProposal with
          factoryCid = self
          venueOperator
          settings

    nonconsuming choice PoolFactory_CreatePool : PoolContracts
      with settings : PoolSettings
      controller dvo
      do
        assertMsg "Factory authority mismatch" (settings.dvo == dvo)
        assertMsg "Invalid pool settings" (validSettings settings)
        poolCid <- create Pool with
          dvo
          venueOperator
          baseInstrumentId = settings.baseInstrumentId
          quoteInstrumentId = settings.quoteInstrumentId
          baseAccount = settings.baseAccount
          quoteAccount = settings.quoteAccount
          lpTokenInstrumentId = settings.lpTokenInstrumentId
        configCid <- create PoolConfig with
          poolCid
          dvo
          venueOperator
          feeBps = settings.feeBps
        stateCid <- create PoolState with
          poolCid
          dvo
          venueOperator
          baseReserve = settings.baseReserve
          quoteReserve = settings.quoteReserve
          lpTokenSupply = settings.lpTokenSupply
          funding = None
        pure PoolContracts with poolCid; configCid; stateCid

-- | Holds the operator's proposed pool settings for dvo to accept or reject.
template PoolProposal
  with
    factoryCid : ContractId PoolFactory
    venueOperator : Party
    settings : PoolSettings
  where
    signatory venueOperator
    observer settings.dvo
    ensure validSettings settings && settings.dvo /= venueOperator

    choice PoolProposal_Accept : PoolContracts
      controller settings.dvo
      do
        factory <- fetch factoryCid
        assertMsg "Factory operator mismatch" (factory.venueOperator == venueOperator)
        assertMsg "Factory authority mismatch" (factory.dvo == settings.dvo)
        exercise factoryCid PoolFactory_CreatePool with settings

    choice PoolProposal_Reject : ()
      controller settings.dvo
      do pure ()

    choice PoolProposal_Withdraw : ()
      controller venueOperator
      do pure ()

validSettings : PoolSettings -> Bool
validSettings settings =
  settings.baseInstrumentId /= settings.quoteInstrumentId
    && settings.lpTokenInstrumentId.admin == settings.dvo
    && settings.baseAccount.owner == Some settings.dvo
    && settings.quoteAccount.owner == Some settings.dvo
    && validFee settings.feeBps
    && settings.baseReserve > 0.0
    && settings.quoteReserve > 0.0
    && settings.lpTokenSupply > 0.0
