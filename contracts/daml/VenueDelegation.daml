-- | Lets the operator settle swaps and liquidity with permission from dvo.
module VenueDelegation where

import Errors
import DA.Foldable (forA_)
import Pool
import PoolAccess
import Lib.Liquidity
import Lib.Swap

-- | Access evidence accompanies each locked request on the operator's delegated path.
data SettlementRequest = SettlementRequest with
    accessCid : ContractId PoolAccess
    request : BatchRequest Pool
  deriving (Eq, Show)

data DepositSettlementRequest = DepositSettlementRequest with
    accessCid : ContractId PoolAccess
    request : DepositBatchRequest Pool
  deriving (Eq, Show)

data WithdrawalSettlementRequest = WithdrawalSettlementRequest with
    accessCid : ContractId PoolAccess
    request : WithdrawalBatchRequest Pool
  deriving (Eq, Show)

-- | Grants the operator dvo's settlement authority for one pool, subject to access and KYC checks.
template VenueDelegation
  with
    dvo : Party
    venueOperator : Party
    poolCid : ContractId Pool
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator

    -- | Recheck access and KYC, then authorize the pool's atomic settlement choice.
    nonconsuming choice VenueDelegation_SettleBatch : SwapBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [SettlementRequest]
        batchId : Text
      controller venueOperator
      do
        validateDelegatedRequests this requests
        exercise poolCid Pool_Swap with configCid; stateCid; requests = map (.request) requests; batchId

    -- | Recheck each trader's access and KYC, then settle their deposits through the pool.
    nonconsuming choice VenueDelegation_AddLiquidity : AddLiquidityBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [DepositSettlementRequest]
      controller venueOperator
      do
        validateLiquidityDelegation this
        forA_ requests $ \item ->
          validateRequestAccess this item.request.request.trader item.accessCid
        exercise poolCid Pool_AddLiquidity with configCid; stateCid; requests = map (.request) requests

    -- | Recheck each trader's access and KYC, then settle their withdrawals through the pool.
    nonconsuming choice VenueDelegation_WithdrawLiquidity : WithdrawLiquidityBatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [WithdrawalSettlementRequest]
      controller venueOperator
      do
        validateLiquidityDelegation this
        forA_ requests $ \item ->
          validateRequestAccess this item.request.request.trader item.accessCid
        exercise poolCid Pool_WithdrawLiquidity with configCid; stateCid; requests = map (.request) requests

    -- | Remove this operator grant without changing the pool or its allocations.
    choice VenueDelegation_Revoke : ()
      controller dvo
      do pure ()

-- | Match the pool authority and every trader's active access before delegation.
validateDelegatedRequests : VenueDelegation -> [SettlementRequest] -> Update ()
validateDelegatedRequests delegation requests = do
  pool <- fetch delegation.poolCid
  assertMsg eDelegationAuthorityMismatch
    (pool.dvo == delegation.dvo && pool.venueOperator == delegation.venueOperator)
  forA_ requests $ \item ->
    validateRequestAccess delegation item.request.request.trader item.accessCid

validateRequestAccess : VenueDelegation -> Party -> ContractId PoolAccess -> Update ()
validateRequestAccess delegation trader accessCid = do
  access <- fetch accessCid
  assertMsg eAccessRequestMismatch
    (access.trader == trader && access.poolCid == delegation.poolCid
      && access.venueOperator == delegation.venueOperator)
  validateAttestation access

validateLiquidityDelegation : VenueDelegation -> Update ()
validateLiquidityDelegation delegation = do
  pool <- fetch delegation.poolCid
  assertMsg eDelegationAuthorityMismatch (pool.dvo == delegation.dvo && pool.venueOperator == delegation.venueOperator)
