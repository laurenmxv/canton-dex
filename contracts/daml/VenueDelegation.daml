-- | Lets the operator settle swaps with permission from the pool authority (dvo).
-- Rechecks each trader's access and KYC before calling the pool.
module VenueDelegation where

import DA.Foldable (forA_)
import Pool
import PoolAccess
import Lib.Swap

-- | Access evidence accompanies each locked request on the operator's delegated path.
data SettlementRequest = SettlementRequest with
    accessCid : ContractId PoolAccess
    request : BatchRequest Pool
  deriving (Eq, Show)

template VenueDelegation
  with
    dvo : Party
    venueOperator : Party
    poolCid : ContractId Pool
  where
    signatory dvo
    observer venueOperator
    ensure dvo /= venueOperator

    -- | Recheck access and KYC, then authorize the pool's atomic settlement choice.
    nonconsuming choice VenueDelegation_SettleBatch : BatchResult
      with
        configCid : ContractId PoolConfig
        stateCid : ContractId PoolState
        requests : [SettlementRequest]
        batchId : Text
      controller venueOperator
      do
        pool <- fetch poolCid
        assertMsg "Delegation pool authority mismatch" (pool.dvo == dvo && pool.venueOperator == venueOperator)
        forA_ requests $ \item -> do
          access <- fetch item.accessCid
          let request = item.request.request
          assertMsg "Access does not match swap request"
            (access.trader == request.trader && access.poolCid == poolCid && access.venueOperator == venueOperator)
          validateAttestation access
        exercise poolCid Pool_Swap with configCid; stateCid; requests = map (.request) requests; batchId

    -- | Remove this operator grant without changing the pool or its allocations.
    choice VenueDelegation_Revoke : ()
      controller dvo
      do pure ()
