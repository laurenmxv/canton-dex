-- | Shared funded-pool fixtures and tests for swap settlement, rollback and expiry.
module FundedSwaps where

import DA.Action ((>=>))
import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.Foldable (forA_)
import DA.Optional (isNone)
import DA.Time (addRelTime, minutes, seconds, time)
import Daml.Script
import Errors
import Test.Assertions
import Fixtures
import Lib.Tokens (Token, emptyArgs)
import Lib.Liquidity
import Lib.Math (liquidityRatio)
import DA.Numeric qualified as Numeric
import OpenZeppelin.TokenCIP112V1.Holding (TokenHolding(..))
import OpenZeppelin.TokenCIP112V1.Registry (TokenRules(..), TokenRules_Mint(..))
import Pool
import PoolAccess
import PoolFactory (PoolContracts(..))
import PoolFactory qualified
import Splice.Api.Token.AllocationInstructionV2 qualified as AI
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.MetadataV1 (Metadata)
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.TokenStandard.Utils (accountParties, basicAccount)
import Lib.Swap
import VenueDelegation

data FundedFixture = FundedFixture with
    parties : Parties
    pool : PoolContracts
    route : SwapRoute Pool
    delegationCid : ContractId VenueDelegation
    baseRulesCid : ContractId TokenRules
    quoteRulesCid : ContractId TokenRules
    lpRulesCid : ContractId TokenRules
  deriving (Eq, Show)

data PreparedRequest = PreparedRequest with
    request : SwapRequest Pool
    accessCid : ContractId PoolAccess
  deriving (Eq, Show)

setup : () -> Script FundedFixture
setup () = setupWithReserves 997.0 1000.0

setupWithReserves : Decimal -> Decimal -> Script FundedFixture
setupWithReserves baseReserve quoteReserve = do
  -- Create an empty pool at a fixed test time and the requested reserve ratio.
  setTime (time (date 2026 Jan 1) 0 0 0)
  parties <- allocateParties ()
  settings <- settingsFor parties
  let ratio = liquidityRatio 10 Numeric.RoundingFloor quoteReserve 1.0 baseReserve
  (_, pool) <- poolFixtureAtRatio parties settings ratio
  f <- emptyFixture parties pool settings
  -- Fund it through the same deposit flow used by traders.
  seeder <- allocateParty "InitialLP"
  (accessCid, request) <- prepareDeposit f seeder "initial-liquidity" InitializeOnly baseReserve quoteReserve
  result <- settleDeposit f pool.stateCid accessCid request
  pure f with pool = pool with stateCid = result.stateCid

emptyFixture : Parties -> PoolContracts -> PoolFactory.PoolSettings -> Script FundedFixture
emptyFixture parties pool settings = do
  Some poolValue <- queryContractId parties.dvo pool.poolCid
  let route = SwapRoute with
        poolCid = pool.poolCid; dvo = parties.dvo; venueOperator = parties.venueOperator
        baseToken = poolValue.baseToken; quoteToken = poolValue.quoteToken
        baseAccount = poolValue.baseAccount; quoteAccount = poolValue.quoteAccount
  delegationCid <- submit parties.dvo $ createCmd VenueDelegation with
    dvo = parties.dvo; venueOperator = parties.venueOperator; poolCid = pool.poolCid
  pure FundedFixture with
    parties; pool; route; delegationCid
    baseRulesCid = fromInterfaceContractId settings.baseToken.allocationFactory
    quoteRulesCid = fromInterfaceContractId settings.quoteToken.allocationFactory
    lpRulesCid = fromInterfaceContractId settings.lpAllocationFactory

liquidityArgs : LiquidityTokenArgs
liquidityArgs = LiquidityTokenArgs with
  baseAllocationArgs = emptyArgs; quoteAllocationArgs = emptyArgs; lpAllocationArgs = emptyArgs
  baseSettlementArgs = emptyArgs; quoteSettlementArgs = emptyArgs; lpSettlementArgs = emptyArgs

prepareDeposit : FundedFixture -> Party -> Text -> DepositMode -> Decimal -> Decimal
  -> Script (ContractId PoolAccess, DepositRequest Pool)
prepareDeposit f trader requestId mode maxBaseAmount maxQuoteAmount = do
  -- Grant access and mint both deposit tokens to the trader.
  (_, accessCid) <- accessFixture f.parties.venueOperator trader f.pool.poolCid
  base <- mint f.baseRulesCid f.parties.baseRegistrar (basicAccount trader) "BASE" maxBaseAmount
  quote <- mint f.quoteRulesCid f.parties.quoteRegistrar (basicAccount trader) "QUOTE" maxQuoteAmount
  requestedAt <- getTime
  let terms = DepositTerms with
        requestId; mode; maxBaseAmount; maxQuoteAmount; minLpOut = 0.0
        minRatio = 0.0000000001; maxRatio = 1000000.0
        settlementDeadline = addRelTime requestedAt (minutes 10)
  disclosures <- rulesDisclosures f
  -- Lock the deposit under the trader's signed terms.
  request <- submit (actAs trader <> discloseMany disclosures) $
    exerciseCmd accessCid PoolAccess_RequestLiquidityDeposit with
      terms; requestedAt; baseHoldingCids = [base]; quoteHoldingCids = [quote]
      baseAllocationArgs = emptyArgs; quoteAllocationArgs = emptyArgs; lpAllocationArgs = emptyArgs
  pure (accessCid, request)

-- Create a native allocation that differs only in its signed application metadata.
allocationWithMetadata : FundedFixture -> Party -> Token -> ContractId A.Allocation -> Metadata
  -> [ContractId H.Holding] -> Script (ContractId A.Allocation)
allocationWithMetadata f trader token originalCid meta inputs = do
  Some original <- queryInterfaceContractId @A.Allocation trader originalCid
  requestedAt <- getTime
  disclosures <- rulesDisclosures f
  result <- submit (actAs trader <> discloseMany disclosures) $
    exerciseCmd token.allocationFactory AI.AllocationFactory_Allocate with
      settlement = original.settlement; requestedAt; inputHoldingCids = inputs
      allocation = original.allocation with meta
      actors = [trader]; extraArgs = emptyArgs
  let AI.AllocationInstructionResult_Completed cid = result.output
  pure cid

data LiquidityFixtureResult = LiquidityFixtureResult with
    stateCid : ContractId PoolState
    receiptCid : ContractId LiquidityReceipt
    baseAmount : Decimal
    quoteAmount : Decimal
    lpAmount : Decimal
  deriving (Eq, Show)

settleDeposit : FundedFixture -> ContractId PoolState -> ContractId PoolAccess -> DepositRequest Pool -> Script LiquidityFixtureResult
settleDeposit f stateCid accessCid request = do
  batch <- settleDepositBatch f stateCid [depositItem accessCid request]
  let [outcome] = batch.outcomes
      [receiptCid] = batch.receiptCids
  pure LiquidityFixtureResult with
    stateCid = batch.stateCid; receiptCid
    baseAmount = outcome.baseAmount; quoteAmount = outcome.quoteAmount; lpAmount = outcome.lpAmount

depositItem : ContractId PoolAccess -> DepositRequest Pool -> DepositSettlementRequest
depositItem accessCid request = DepositSettlementRequest with
  accessCid; request = DepositBatchRequest with request; tokenArgs = liquidityArgs

settleDepositBatch : FundedFixture -> ContractId PoolState -> [DepositSettlementRequest] -> Script AddLiquidityBatchResult
settleDepositBatch f stateCid requests = do
  disclosures <- settlementDisclosures f stateCid
  submit (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.delegationCid VenueDelegation_AddLiquidity with
      configCid = f.pool.configCid; stateCid; requests

withdrawalItem : ContractId PoolAccess -> WithdrawalRequest Pool -> WithdrawalSettlementRequest
withdrawalItem accessCid request = WithdrawalSettlementRequest with
  accessCid; request = WithdrawalBatchRequest with request; tokenArgs = liquidityArgs

settleWithdrawalBatch : FundedFixture -> ContractId PoolState -> [WithdrawalSettlementRequest] -> Script WithdrawLiquidityBatchResult
settleWithdrawalBatch f stateCid requests = do
  disclosures <- settlementDisclosures f stateCid
  submit (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.delegationCid VenueDelegation_WithdrawLiquidity with
      configCid = f.pool.configCid; stateCid; requests

currentAccess : FundedFixture -> Party -> Script (ContractId PoolAccess)
currentAccess f trader = do
  accesses <- query @PoolAccess trader
  case [cid | (cid, access) <- accesses, access.poolCid == f.pool.poolCid,
        access.venueOperator == f.parties.venueOperator] of
    cid :: _ -> pure cid
    [] -> abort "test trader has no pool access"

rulesDisclosures : FundedFixture -> Script [Disclosure]
rulesDisclosures f = do
  Some base <- queryDisclosure @TokenRules f.parties.baseRegistrar f.baseRulesCid
  Some quote <- queryDisclosure @TokenRules f.parties.quoteRegistrar f.quoteRulesCid
  Some pool <- queryDisclosure @Pool f.parties.dvo f.pool.poolCid
  Some lp <- queryDisclosure @TokenRules f.parties.dvo f.lpRulesCid
  pure [base, quote, lp, pool]

-- Bootstrap owns these blobs; settlement never receives DVO actAs or readAs rights.
settlementDisclosures : FundedFixture -> ContractId PoolState -> Script [Disclosure]
settlementDisclosures f stateCid = do
  rules <- rulesDisclosures f
  Some state <- queryContractId f.parties.dvo stateCid
  holdings <- forA (state.baseHoldingCids <> state.quoteHoldingCids) $ \cid -> do
    Some disclosure <- queryDisclosure @TokenHolding f.parties.dvo (fromInterfaceContractId cid)
    pure disclosure
  pure (rules <> holdings)

mint : ContractId TokenRules -> Party -> H.Account -> Text -> Decimal -> Script (ContractId H.Holding)
mint rulesCid admin account instrumentId amount = do
  cid <- submit (actAs (admin :: accountParties admin account)) $ exerciseCmd rulesCid TokenRules_Mint with
    account; instrumentId; amount; reason = "Funded swap test"
  pure (toInterfaceContractId @H.Holding cid)

prepare : FundedFixture -> Party -> Text -> SwapDirection -> Decimal -> Decimal -> Script PreparedRequest
prepare f trader requestId direction amountIn minOut = do
  -- Grant access and mint the token used as swap input.
  (_, accessCid) <- accessFixture f.parties.venueOperator trader f.pool.poolCid
  let (rulesCid, token) = case direction of
        BaseToQuote -> (f.baseRulesCid, f.route.baseToken)
        QuoteToBase -> (f.quoteRulesCid, f.route.quoteToken)
  input <- mint rulesCid token.instrument.admin (basicAccount trader) token.instrument.id amountIn
  requestedAt <- getTime
  let terms = SwapTerms with
        requestId; direction; amountIn; minOut
        settlementDeadline = addRelTime requestedAt (minutes 10)
  disclosures <- rulesDisclosures f
  -- Lock the input and create the paired output allocation as the trader.
  request <- submit (actAs trader <> discloseMany disclosures) $
    exerciseCmd accessCid (PoolAccess_RequestSwap with
      route = f.route; terms; requestedAt; inputHoldingCids = [input]
      inputAllocationArgs = emptyArgs; outputAllocationArgs = emptyArgs)
  pure PreparedRequest with request; accessCid

settle : FundedFixture -> ContractId PoolState -> Text -> [PreparedRequest] -> Script SwapBatchResult
settle f stateCid batchId prepared = do
  disclosures <- settlementDisclosures f stateCid
  submit (actAs f.parties.venueOperator <> discloseMany disclosures) $
      exerciseCmd f.delegationCid VenueDelegation_SettleBatch with
        configCid = f.pool.configCid; stateCid; batchId; requests = map settlementRequest prepared

batchRequest : SwapRequest Pool -> BatchRequest Pool
batchRequest request = BatchRequest with
  request
  poolInputAllocationArgs = emptyArgs; poolOutputAllocationArgs = emptyArgs
  inputSettlementArgs = emptyArgs; outputSettlementArgs = emptyArgs

settlementRequest : PreparedRequest -> SettlementRequest
settlementRequest prepared = SettlementRequest with
  accessCid = prepared.accessCid; request = batchRequest prepared.request

assertPending : PreparedRequest -> Script ()
assertPending prepared = forA_ [prepared.request.inputAllocation, prepared.request.outputAllocation] $ \cid -> do
  Some _ <- queryInterfaceContractId @A.Allocation prepared.request.trader cid
  pure ()

withdrawal : ContractId A.Allocation -> AllocationWithdrawal
withdrawal allocationCid = AllocationWithdrawal with allocationCid; extraArgs = emptyArgs

availableBalance : Party -> H.InstrumentId -> Script Decimal
availableBalance owner instrument = do
  holdings <- query @TokenHolding owner
  pure (sum [h.holding.amount | (_, h) <- holdings,
    h.holding.account == basicAccount owner, h.holding.instrumentId == instrument, isNone h.holding.lock])

assertBacking : FundedFixture -> ContractId PoolState -> Script PoolState
assertBacking f stateCid = do
  Some state <- queryContractId f.parties.dvo stateCid
  let total cids = do
        views <- forA cids $ \cid -> do
          Some holding <- queryInterfaceContractId @H.Holding f.parties.dvo cid
          pure holding
        forA_ views $ \holding -> holding.lock === None
        pure (sum (map (.amount) views))
  base <- total state.baseHoldingCids
  quote <- total state.quoteHoldingCids
  base === state.baseReserve
  quote === state.quoteReserve
  pure state

sequentialFundedBatch : Script ()
sequentialFundedBatch = script do
  -- Lock two swaps against the same initial reserves.
  f <- setup ()
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  first <- prepare f alice "alice-swap" BaseToQuote 1000.0 500.0
  second <- prepare f bob "bob-swap" BaseToQuote 1000.0 160.0
  availableBalance alice f.route.baseToken.instrument >>= (=== 0.0)
  availableBalance bob f.route.baseToken.instrument >>= (=== 0.0)
  -- Price the second swap using the reserves left by the first.
  result <- settle f f.pool.stateCid "batch-two" [first, second]
  result.amountsOut === [500.0, 166.499665]
  state <- assertBacking f result.stateCid
  state.baseReserve === 2997.0
  state.quoteReserve === 333.500335
  availableBalance alice f.route.quoteToken.instrument >>= (=== 500.0)
  availableBalance bob f.route.quoteToken.instrument >>= (=== 166.499665)
  availableBalance alice f.route.baseToken.instrument >>= (=== 0.0)
  availableBalance bob f.route.baseToken.instrument >>= (=== 0.0)
  -- Check allocations are consumed and each trader sees only their own receipt.
  forA_ [first, second] $ \prepared ->
    forA_ [prepared.request.inputAllocation, prepared.request.outputAllocation]
      (queryInterfaceContractId @A.Allocation prepared.request.trader >=> (=== None))
  receipts <- query @SwapReceipt f.parties.venueOperator
  length receipts === 2
  aliceReceipts <- query @SwapReceipt alice
  bobReceipts <- query @SwapReceipt bob
  map (\(_, receipt) -> receipt.trader) aliceReceipts === [alice]
  map (\(_, receipt) -> receipt.trader) bobReceipts === [bob]
  stranger <- allocateParty "ReceiptStranger"
  query @SwapReceipt stranger >>= (=== [])
  queryContractId f.parties.dvo f.pool.stateCid >>= (=== None)

reverseDirectionMovesTokens : Script ()
reverseDirectionMovesTokens = script do
  -- Swap quote tokens for base tokens.
  f <- setup ()
  trader <- allocateParty "ReverseTrader"
  request <- prepare f trader "quote-to-base" QuoteToBase 500.0 330.0
  result <- settle f f.pool.stateCid "reverse-batch" [request]
  -- Check the payout and both reserve changes are backed by real holdings.
  result.amountsOut === [331.668001]
  state <- assertBacking f result.stateCid
  state.baseReserve === 665.331999
  state.quoteReserve === 1500.0
  availableBalance trader f.route.baseToken.instrument >>= (=== 331.668001)
  availableBalance trader f.route.quoteToken.instrument >>= (=== 0.0)

operatorRequiresDvoDelegation : Script ()
operatorRequiresDvoDelegation = script do
  f <- setup ()
  trader <- allocateParty "DelegatedTrader"
  request <- prepare f trader "delegation-required" BaseToQuote 1000.0 500.0
  Some state <- queryContractId f.parties.dvo f.pool.stateCid
  disclosures <- settlementDisclosures f f.pool.stateCid
  -- Valid inputs and visibility do not replace the DVO settlement authority.
  submitMustFail (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.pool.poolCid Pool_Swap with
      configCid = f.pool.configCid; stateCid = f.pool.stateCid; batchId = "no-delegation"
      requests = [batchRequest request.request]
  queryContractId f.parties.dvo f.pool.stateCid >>= (=== Some state)
  -- Retry through the dvo delegation and receive the expected output.
  result <- settle f f.pool.stateCid "delegated" [request]
  result.amountsOut === [500.0]

duplicateAllocationLeavesBackingUnchanged : Script ()
duplicateAllocationLeavesBackingUnchanged = script do
  -- Snapshot the backing before submitting the same request twice.
  f <- setup ()
  trader <- allocateParty "DuplicateTrader"
  request <- prepare f trader "once-only" BaseToQuote 1000.0 500.0
  beforeBase <- query @TokenHolding f.parties.baseRegistrar
  beforeQuote <- query @TokenHolding f.parties.quoteRegistrar
  beforeState <- queryContractId f.parties.dvo f.pool.stateCid
  disclosures <- settlementDisclosures f f.pool.stateCid
  -- Reject duplicate allocations and check the transaction leaves no changes.
  submitFailsWith eDuplicateAllocation (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.delegationCid VenueDelegation_SettleBatch with
      configCid = f.pool.configCid; stateCid = f.pool.stateCid; batchId = "duplicate"
      requests = map settlementRequest [request, request]
  query @TokenHolding f.parties.baseRegistrar >>= (=== beforeBase)
  query @TokenHolding f.parties.quoteRegistrar >>= (=== beforeQuote)
  queryContractId f.parties.dvo f.pool.stateCid >>= (=== beforeState)
  query @SwapReceipt trader >>= (=== [])
  -- Settle the request once to confirm it remains usable.
  result <- settle f f.pool.stateCid "single" [request]
  result.amountsOut === [500.0]

largeAmountsSettle : Script ()
largeAmountsSettle = script do
  -- Settle a swap with input and reserves above one million tokens.
  f <- setupWithReserves 2991000.0 5982000.0
  trader <- allocateParty "LargeSwapTrader"
  request <- prepare f trader "large-swap" BaseToQuote 3000000.0 2991000.0
  result <- settle f f.pool.stateCid "large-batch" [request]
  -- Check the exact payout, remaining reserves and spent input.
  result.amountsOut === [2991000.0]
  state <- assertBacking f result.stateCid
  state.baseReserve === 5991000.0
  state.quoteReserve === 2991000.0
  availableBalance trader f.route.quoteToken.instrument >>= (=== 2991000.0)
  availableBalance trader f.route.baseToken.instrument >>= (=== 0.0)

batchReservesCanExceedOneMillion : Script ()
batchReservesCanExceedOneMillion = script do
  -- Follow a small swap with a large input in the same batch.
  f <- setup ()
  alice <- allocateParty "FirstTrader"
  bob <- allocateParty "LargeInputTrader"
  first <- prepare f alice "first" BaseToQuote 1000.0 500.0
  second <- prepare f bob "large-input" BaseToQuote 1999000.0 0.0
  result <- settle f f.pool.stateCid "large-reserve-batch" [first, second]
  -- Check sequential pricing and backing after reserves cross one million.
  result.amountsOut === [500.0, 499.499498]
  state <- assertBacking f result.stateCid
  state.baseReserve === 2000997.0
  state.quoteReserve === 0.500502
  availableBalance alice f.route.quoteToken.instrument >>= (=== 500.0)
  availableBalance bob f.route.quoteToken.instrument >>= (=== 499.499498)

secondSlippageRollsBack : Script ()
secondSlippageRollsBack = script do
  -- Lock two swaps whose minimums cannot both be met in one batch.
  f <- setup ()
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  first <- prepare f alice "alice-swap" BaseToQuote 1000.0 500.0
  second <- prepare f bob "bob-swap" BaseToQuote 1000.0 500.0
  beforeBase <- query @TokenHolding f.parties.baseRegistrar
  beforeQuote <- query @TokenHolding f.parties.quoteRegistrar
  beforeState <- queryContractId f.parties.dvo f.pool.stateCid
  disclosures <- settlementDisclosures f f.pool.stateCid
  -- Reject the second swap and roll back the whole batch.
  submitFailsWith eSwapBelowMinimumOutput (actAs f.parties.venueOperator <> discloseMany disclosures) $
      exerciseCmd f.delegationCid VenueDelegation_SettleBatch with
        configCid = f.pool.configCid; stateCid = f.pool.stateCid; batchId = "atomic-failure"
        requests = map settlementRequest [first, second]
  -- Check backing, pending allocations and receipts remain unchanged.
  query @TokenHolding f.parties.baseRegistrar >>= (=== beforeBase)
  query @TokenHolding f.parties.quoteRegistrar >>= (=== beforeQuote)
  queryContractId f.parties.dvo f.pool.stateCid >>= (=== beforeState)
  query @SwapReceipt f.parties.venueOperator >>= (=== [])
  forA_ [first, second] $ \prepared -> do
    assertPending prepared
    availableBalance prepared.request.trader f.route.quoteToken.instrument >>= (=== 0.0)
  -- The first request is valid on its own; the failed batch did not consume it.
  result <- settle f f.pool.stateCid "first-only" [first]
  result.amountsOut === [500.0]
  assertPending second
  pure ()

expiryReturnsFundsWithoutVenue : Script ()
expiryReturnsFundsWithoutVenue = script do
  -- Prepare requests for recovery through pool access and directly through the token.
  f <- setup ()
  alice <- allocateParty "Alice"
  stranger <- allocateParty "Stranger"
  wrapped <- prepare f alice "wrapped-reclaim" BaseToQuote 10.0 0.0
  direct <- prepare f alice "direct-reclaim" QuoteToBase 11.0 0.0
  disclosures <- rulesDisclosures f
  let withdrawWrapped = PoolAccess_RecoverAllocations with
        withdrawals = map withdrawal [wrapped.request.inputAllocation, wrapped.request.outputAllocation]
      aliceOptions = actAs alice <> discloseMany disclosures
  -- Reject early recovery and recovery by another trader.
  submitMustFail aliceOptions $ exerciseCmd wrapped.accessCid withdrawWrapped
  submitMustFail alice $ exerciseCmd direct.request.inputAllocation A.Allocation_Withdraw with
    actors = [alice]; extraArgs = emptyArgs
  submitMustFail (actAs stranger <> readAs alice <> discloseMany disclosures) $
    exerciseCmd wrapped.accessCid withdrawWrapped
  -- Revoke delegation and direct-request access, then expire both requests.
  submit f.parties.dvo $ exerciseCmd f.delegationCid VenueDelegation_Revoke
  submit f.parties.venueOperator $ archiveCmd direct.accessCid
  setTime (addRelTime wrapped.request.terms.settlementDeadline (seconds 1))
  -- Recover through each path without venue authority and keep pool reserves intact.
  results <- submit aliceOptions $ exerciseCmd wrapped.accessCid withdrawWrapped
  length results === 2
  forA_ [direct.request.inputAllocation, direct.request.outputAllocation] $ \cid -> do
    result <- submit alice $ exerciseCmd cid A.Allocation_Withdraw with
      actors = [alice]; extraArgs = emptyArgs
    result.output === A.AllocationResult_Withdrawn
  availableBalance alice f.route.baseToken.instrument >>= (=== 10.0)
  availableBalance alice f.route.quoteToken.instrument >>= (=== 11.0)
  state <- assertBacking f f.pool.stateCid
  state.baseReserve === 997.0
  state.quoteReserve === 1000.0

expiredRequestCannotSettle : Script ()
expiredRequestCannotSettle = script do
  -- Advance a funded request past its settlement deadline.
  f <- setup ()
  trader <- allocateParty "ExpiredTrader"
  request <- prepare f trader "expired-swap" BaseToQuote 1000.0 500.0
  setTime (addRelTime request.request.terms.settlementDeadline (seconds 1))
  disclosures <- settlementDisclosures f f.pool.stateCid
  -- Reject settlement, keep the allocations pending and allow the trader to recover.
  submitMustFail (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.delegationCid VenueDelegation_SettleBatch with
      configCid = f.pool.configCid; stateCid = f.pool.stateCid; batchId = "expired"
      requests = [settlementRequest request]
  assertPending request
  query @SwapReceipt trader >>= (=== [])
  _ <- submit (actAs trader <> discloseMany disclosures) $
    exerciseCmd request.accessCid PoolAccess_RecoverAllocations with
      withdrawals = map withdrawal [request.request.inputAllocation, request.request.outputAllocation]
  availableBalance trader f.route.baseToken.instrument >>= (=== 1000.0)

unfundedPoolsCannotSettleRequests : Script ()
unfundedPoolsCannotSettleRequests = script do
  -- Lock a valid request before the pool receives its first deposit.
  f <- setup ()
  settings <- settingsFor f.parties
  (_, pool) <- poolFixtureWithSettings f.parties settings
  candidate <- emptyFixture f.parties pool settings
  trader <- allocateParty "UnfundedPoolTrader"
  request <- prepare candidate trader "await-funding" BaseToQuote 1000.0 500.0
  Some before <- queryContractId f.parties.dvo pool.stateCid
  before.baseReserve === 0.0
  disclosures <- rulesDisclosures candidate
  -- Reject settlement without consuming the request or changing the empty pool.
  submitFailsWith ePoolNotFunded (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd candidate.delegationCid VenueDelegation_SettleBatch with
      configCid = pool.configCid; stateCid = pool.stateCid
      requests = [settlementRequest request]; batchId = "unfunded"
  queryContractId f.parties.dvo pool.stateCid >>= (=== Some before)
  assertPending request
  -- Add initial liquidity and settle the original request successfully.
  seeder <- allocateParty "DeferredInitialLP"
  (accessCid, deposit) <- prepareDeposit candidate seeder "fund-later" InitializeOnly 997.0 1000.0
  funded <- settleDeposit candidate pool.stateCid accessCid deposit
  result <- settle candidate funded.stateCid "funded" [request]
  result.amountsOut === [500.0]
  _ <- assertBacking candidate result.stateCid
  availableBalance trader candidate.route.quoteToken.instrument >>= (=== 500.0)
