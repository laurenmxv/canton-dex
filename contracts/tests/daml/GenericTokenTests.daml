module GenericTokenTests where

import Test.Errors
import DA.Assert ((===))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, seconds)
import Daml.Script
import Errors
import Test.Assertions
import Fixtures
import FundedSwaps
import Lib.Tokens (emptyArgs)
import Pool
import Splice.Api.Token.AllocationInstructionV2 qualified as AI
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.MetadataV1
import Lib.Swap
import SwapRequestTests (prepareArgs)
import VenueDelegation

-- These adapters exercise standard interface dispatch and context forwarding.
-- The original OZ registry remains responsible for token issuance and settlement.
template ContextAllocationFactory
  with
    admin : Party
    delegate : ContractId AI.AllocationFactory
    expectedArgs : ExtraArgs
  where
    signatory admin
    interface instance AI.AllocationFactory for ContextAllocationFactory where
      view = AI.AllocationFactoryView with admin; meta = emptyMetadata
      allocationFactory_publicFetchImpl _ _ = pure (AI.AllocationFactoryView with admin; meta = emptyMetadata)
      allocationFactory_allocateExtraObservers _ = []
      allocationFactory_allocateImpl _ arg = do
        assertMsg eAllocationContextMismatch (arg.extraArgs == expectedArgs)
        exercise delegate arg

template ContextSettlementFactory
  with
    admin : Party
    delegate : ContractId A.SettlementFactory
    expectedArgs : ExtraArgs
  where
    signatory admin
    interface instance A.SettlementFactory for ContextSettlementFactory where
      view = A.SettlementFactoryView with admin; meta = emptyMetadata
      settlementFactory_publicFetchImpl _ _ = pure (A.SettlementFactoryView with admin; meta = emptyMetadata)
      settlementFactory_settleBatchExtraObservers _ = []
      settlementFactory_settleBatchImpl _ arg = do
        assertMsg eSettlementContextMismatch (arg.extraArgs == expectedArgs)
        exercise delegate arg

-- A withdrawal-only interface fixture; it does not represent a funded token.
template ContextAllocation
  with
    owner : Party
    allocationView : A.AllocationView
    expectedArgs : ExtraArgs
    pending : Bool
  where
    signatory owner
    interface instance A.Allocation for ContextAllocation where
      view = allocationView
      allocation_settleExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_settleImpl _ _ = abort eContextSettlementUnsupported
      allocation_cancelImpl _ _ = abort eContextCancellationUnsupported
      allocation_withdrawImpl self arg = do
        assertMsg eWithdrawalContextMismatch (arg.extraArgs == expectedArgs)
        archive (fromInterfaceContractId self : ContractId ContextAllocation)
        output <- if pending then do
            nextCid <- create this
            pure (A.AllocationResult_Pending (toInterfaceContractId @A.Allocation nextCid))
          else pure A.AllocationResult_Withdrawn
        pure (A.AllocationResult with
          output; authorizerHoldingCids = TextMap.empty; meta = emptyMetadata)

contextArgs : Text -> ExtraArgs
contextArgs label = ExtraArgs with
  context = ChoiceContext with values = TextMap.fromList [("test-context", AV_Text label)]
  meta = Metadata with values = TextMap.fromList [("test-metadata", label)]

separateFactoriesReceiveAllocationAndSettlementContext : Script ()
separateFactoriesReceiveAllocationAndSettlementContext = script do
  f <- setup ()
  let baseAllocationArgs = contextArgs "base-allocation"
      quoteAllocationArgs = contextArgs "quote-allocation"
      baseSettlementArgs = contextArgs "base-settlement"
      quoteSettlementArgs = contextArgs "quote-settlement"
  baseAllocationFactory <- submit f.parties.baseRegistrar $ createCmd ContextAllocationFactory with
    admin = f.parties.baseRegistrar; delegate = f.route.baseToken.allocationFactory; expectedArgs = baseAllocationArgs
  quoteAllocationFactory <- submit f.parties.quoteRegistrar $ createCmd ContextAllocationFactory with
    admin = f.parties.quoteRegistrar; delegate = f.route.quoteToken.allocationFactory; expectedArgs = quoteAllocationArgs
  baseSettlementFactory <- submit f.parties.baseRegistrar $ createCmd ContextSettlementFactory with
    admin = f.parties.baseRegistrar; delegate = f.route.baseToken.settlementFactory; expectedArgs = baseSettlementArgs
  quoteSettlementFactory <- submit f.parties.quoteRegistrar $ createCmd ContextSettlementFactory with
    admin = f.parties.quoteRegistrar; delegate = f.route.quoteToken.settlementFactory; expectedArgs = quoteSettlementArgs
  Some baseAllocationDisclosure <- queryDisclosure @ContextAllocationFactory f.parties.baseRegistrar baseAllocationFactory
  Some quoteAllocationDisclosure <- queryDisclosure @ContextAllocationFactory f.parties.quoteRegistrar quoteAllocationFactory
  Some baseSettlementDisclosure <- queryDisclosure @ContextSettlementFactory f.parties.baseRegistrar baseSettlementFactory
  Some quoteSettlementDisclosure <- queryDisclosure @ContextSettlementFactory f.parties.quoteRegistrar quoteSettlementFactory
  let adapterDisclosures =
        [baseAllocationDisclosure, quoteAllocationDisclosure, baseSettlementDisclosure, quoteSettlementDisclosure]
      baseToken = f.route.baseToken with
        allocationFactory = toInterfaceContractId @AI.AllocationFactory baseAllocationFactory
        settlementFactory = toInterfaceContractId @A.SettlementFactory baseSettlementFactory
      quoteToken = f.route.quoteToken with
        allocationFactory = toInterfaceContractId @AI.AllocationFactory quoteAllocationFactory
        settlementFactory = toInterfaceContractId @A.SettlementFactory quoteSettlementFactory
  (_, pool) <- poolFixture f.parties
  base <- mint f.baseRulesCid f.parties.baseRegistrar f.route.baseAccount "BASE" 997.0
  quote <- mint f.quoteRulesCid f.parties.quoteRegistrar f.route.quoteAccount "QUOTE" 1000.0
  rules <- rulesDisclosures f
  stateCid <- submit (actAs f.parties.dvo <> discloseMany (adapterDisclosures <> rules)) $
    exerciseCmd pool.poolCid Pool_Fund with
      configCid = pool.configCid; stateCid = pool.stateCid
      funding = PoolFunding with baseToken; quoteToken; baseHoldingCids = [base]; quoteHoldingCids = [quote]
  delegationCid <- submit f.parties.dvo $ createCmd VenueDelegation with
    dvo = f.parties.dvo; venueOperator = f.parties.venueOperator; poolCid = pool.poolCid
  let candidate = f with
        pool = (pool with stateCid); delegationCid
        route = (f.route with poolCid = pool.poolCid; baseToken; quoteToken)
  trader <- allocateParty "ContextTrader"
  (accessCid, args) <- prepareArgs candidate trader "context-swap"
  candidateRules <- rulesDisclosures candidate
  let validArgs = args with inputAllocationArgs = baseAllocationArgs; outputAllocationArgs = quoteAllocationArgs
      traderOptions = actAs trader <> discloseMany (adapterDisclosures <> candidateRules)
  submitFailsWith eAllocationContextMismatch traderOptions $ exerciseCmd accessCid (validArgs with inputAllocationArgs = emptyArgs)
  availableBalance trader baseToken.instrument >>= (=== 10.0)
  request <- submit traderOptions $ exerciseCmd accessCid validArgs
  disclosures <- settlementDisclosures candidate stateCid
  let batch = BatchRequest with
        request; poolInputAllocationArgs = baseAllocationArgs; poolOutputAllocationArgs = quoteAllocationArgs
        inputSettlementArgs = baseSettlementArgs; outputSettlementArgs = quoteSettlementArgs
      operatorOptions = actAs f.parties.venueOperator <> discloseMany (adapterDisclosures <> disclosures)
  Some before <- queryContractId f.parties.dvo stateCid
  submitFailsWith eSettlementContextMismatch operatorOptions $ exerciseCmd delegationCid VenueDelegation_SettleBatch with
    configCid = pool.configCid; stateCid; batchId = "missing-context"
    requests = [SettlementRequest with accessCid; request = (batch with outputSettlementArgs = emptyArgs)]
  queryContractId f.parties.dvo stateCid >>= (=== Some before)
  Some _ <- queryInterfaceContractId @A.Allocation trader request.inputAllocation
  availableBalance trader quoteToken.instrument >>= (=== 0.0)
  result <- submit operatorOptions $ exerciseCmd delegationCid VenueDelegation_SettleBatch with
    configCid = pool.configCid; stateCid; batchId = "forwarded-context"; requests = [SettlementRequest with accessCid; request = batch]
  result.amountsOut === [9.900990]
  state <- assertBacking candidate result.stateCid
  state.baseReserve === 1007.0
  state.quoteReserve === 990.099010
  availableBalance trader quoteToken.instrument >>= (=== 9.900990)

genericAllocationReceivesWithdrawalContext : Script ()
genericAllocationReceivesWithdrawalContext = script do
  f <- setup ()
  trader <- allocateParty "WithdrawalContextTrader"
  prepared <- prepare f trader "withdrawal-context" BaseToQuote 10.0 0.0
  let request = prepared.request
  Some originalView <- queryInterfaceContractId @A.Allocation trader request.inputAllocation
  let expectedArgs = contextArgs "withdrawal"
      allocationView = originalView with
        holdingCids = []
        allocation = (originalView.allocation with nextIterationFunding = Some TextMap.empty)
  cid <- submit trader $ createCmd ContextAllocation with owner = trader; allocationView; expectedArgs; pending = False
  setTime (addRelTime request.terms.settlementDeadline (seconds 1))
  disclosures <- rulesDisclosures f
  let allocationCid = toInterfaceContractId @A.Allocation cid
      options = actAs trader <> discloseMany disclosures
  submitFailsWith eWithdrawalContextMismatch options $ exerciseCmd f.pool.poolCid Pool_WithdrawSwap with
    trader; withdrawals = [AllocationWithdrawal with allocationCid; extraArgs = emptyArgs]
  queryInterfaceContractId @A.Allocation trader allocationCid >>= (=== Some allocationView)
  results <- submit options $ exerciseCmd f.pool.poolCid Pool_WithdrawSwap with
    trader; withdrawals = [AllocationWithdrawal with allocationCid; extraArgs = expectedArgs]
  map (.output) results === [A.AllocationResult_Withdrawn]
  queryInterfaceContractId @A.Allocation trader allocationCid >>= (=== None)
  queryInterfaceContractId @A.Allocation trader request.inputAllocation >>= (=== Some originalView)

pendingWithdrawalPreservesAllocation : Script ()
pendingWithdrawalPreservesAllocation = script do
  f <- setup ()
  trader <- allocateParty "PendingWithdrawalTrader"
  prepared <- prepare f trader "pending-withdrawal" BaseToQuote 10.0 0.0
  let request = prepared.request
  Some originalView <- queryInterfaceContractId @A.Allocation trader request.inputAllocation
  let allocationView = originalView with
        holdingCids = []
        allocation = (originalView.allocation with nextIterationFunding = Some TextMap.empty)
  cid <- submit trader $ createCmd ContextAllocation with
    owner = trader; allocationView; expectedArgs = emptyArgs; pending = True
  let allocationCid = toInterfaceContractId @A.Allocation cid
  setTime (addRelTime request.terms.settlementDeadline (seconds 1))
  before <- query @ContextAllocation trader
  disclosures <- rulesDisclosures f
  submitFailsWith eTokenWithdrawalIncomplete (actAs trader <> discloseMany disclosures) $
    exerciseCmd f.pool.poolCid Pool_WithdrawSwap with
      trader; withdrawals = [withdrawal allocationCid]
  query @ContextAllocation trader >>= (=== before)
  queryInterfaceContractId @A.Allocation trader allocationCid >>= (=== Some allocationView)
  queryInterfaceContractId @A.Allocation trader request.inputAllocation >>= (=== Some originalView)

  -- The fixture itself can advance to Pending; the pool withdrawal must roll that transition back.
  result <- submit trader $ exerciseCmd allocationCid A.Allocation_Withdraw with actors = [trader]; extraArgs = emptyArgs
  let A.AllocationResult_Pending nextCid = result.output
  queryInterfaceContractId @A.Allocation trader allocationCid >>= (=== None)
  queryInterfaceContractId @A.Allocation trader nextCid >>= (=== Some allocationView)

settlementRejectsAnotherTraderAllocation : Script ()
settlementRejectsAnotherTraderAllocation = script do
  f <- setup ()
  alice <- allocateParty "AllocationOwnerAlice"
  bob <- allocateParty "AllocationOwnerBob"
  first <- prepare f alice "shared-settlement-id" BaseToQuote 10.0 0.0
  second <- prepare f bob "shared-settlement-id" BaseToQuote 10.0 0.0
  let firstRequest = first.request
      secondRequest = second.request
      substituted = firstRequest with inputAllocation = secondRequest.inputAllocation
  Some firstView <- queryInterfaceContractId @A.Allocation alice firstRequest.inputAllocation
  Some secondView <- queryInterfaceContractId @A.Allocation bob secondRequest.inputAllocation
  firstView.settlement === secondView.settlement
  Some stateBefore <- queryContractId f.parties.dvo f.pool.stateCid
  disclosures <- settlementDisclosures f f.pool.stateCid
  -- The issuer, amount, deadlines, and settlement match; the input belongs to Bob.
  submitFailsWith eAllocationTermsMismatch (actAs f.parties.venueOperator <> discloseMany disclosures) $
    exerciseCmd f.delegationCid VenueDelegation_SettleBatch with
      configCid = f.pool.configCid; stateCid = f.pool.stateCid; batchId = "wrong-authorizer"
      requests = [SettlementRequest with accessCid = first.accessCid; request = batchRequest substituted]
  queryContractId f.parties.dvo f.pool.stateCid >>= (=== Some stateBefore)
  queryInterfaceContractId @A.Allocation bob secondRequest.inputAllocation >>= (=== Some secondView)
  availableBalance alice f.route.quoteToken.instrument >>= (=== 0.0)
  availableBalance bob f.route.quoteToken.instrument >>= (=== 0.0)
  result <- settle f f.pool.stateCid "matching-authorizer" [first]
  result.amountsOut === [9.900990]
