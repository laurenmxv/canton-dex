module HoldingBoundsTests where

import DA.Assert ((===))
import DA.Time (addRelTime, minutes)
import Daml.Script
import Errors
import Test.Assertions
import Fixtures
import FundedSwaps
import Lib.Tokens (emptyArgs)
import Pool
import PoolAccess
import Splice.TokenStandard.Utils (basicAccount)
import Lib.Swap
import Splice.Api.Token.AllocationV2 qualified as A

sameDirectionBatchesPreserveBacking : Script ()
sameDirectionBatchesPreserveBacking = script do
  f <- setup ()
  trader <- allocateParty "RepeatedTrader"
  stateCid <- repeatBatches f trader f.pool.stateCid [1, 2, 3]
  state <- assertBacking f stateCid
  state.baseReserve === 1012.0
  assertMsg "base holdings remain bounded" (length state.baseHoldingCids <= 2)
  assertMsg "quote holdings remain bounded" (length state.quoteHoldingCids <= 2)
  received <- availableBalance trader f.route.quoteToken.instrument
  (state.quoteReserve + received) === 1000.0
  availableBalance trader f.route.baseToken.instrument >>= (=== 0.0)

repeatBatches : FundedFixture -> Party -> ContractId PoolState -> [Int] -> Script (ContractId PoolState)
repeatBatches _ _ stateCid [] = pure stateCid
repeatBatches f trader stateCid (batch :: remaining) = do
  requests <- forA [1..5] $ \index ->
    prepare f trader ("repeated-" <> show batch <> "-" <> show index) BaseToQuote 1.0 0.0
  result <- settle f stateCid ("repeated-batch-" <> show batch) requests
  length result.amountsOut === 5
  _ <- assertBacking f result.stateCid
  repeatBatches f trader result.stateCid remaining

traderInputLimitUsesDistinctRealHoldings : Script ()
traderInputLimitUsesDistinctRealHoldings = script do
  f <- setup ()
  trader <- allocateParty "ManyHoldingsTrader"
  (_, accessCid) <- accessFixture f.parties.venueOperator trader f.pool.poolCid
  inputs <- forA [1..17] $ \_ ->
    mint f.baseRulesCid f.parties.baseRegistrar (basicAccount trader) "BASE" 1.0
  requestedAt <- getTime
  let terms = SwapTerms with
        requestId = "seventeen-inputs"; direction = BaseToQuote; amountIn = 17.0; minOut = 0.0
        settlementDeadline = addRelTime requestedAt (minutes 10)
      preparation = PoolAccess_RequestSwap with
        route = f.route; terms; requestedAt; inputHoldingCids = inputs
        inputAllocationArgs = emptyArgs; outputAllocationArgs = emptyArgs
  disclosures <- rulesDisclosures f
  submitFailsWith eSwapInputHoldingLimit (actAs trader <> discloseMany disclosures) $
    exerciseCmd accessCid preparation
  availableBalance trader f.route.baseToken.instrument >>= (=== 17.0)
  request <- submit (actAs trader <> discloseMany disclosures) $
    exerciseCmd accessCid (preparation with
      terms = (terms with requestId = "sixteen-inputs"; amountIn = 16.0)
      inputHoldingCids = take 16 inputs)
  Some _ <- queryInterfaceContractId @A.Allocation trader request.inputAllocation
  availableBalance trader f.route.baseToken.instrument >>= (=== 1.0)
