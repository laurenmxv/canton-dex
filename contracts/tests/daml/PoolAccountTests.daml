module PoolAccountTests where

import DA.Assert ((===))
import DA.Foldable (forA_)
import Daml.Script
import Errors
import Test.Assertions
import FundedSwaps
import Pool
import Lib.Swap
import Splice.Api.Token.HoldingV2 qualified as H

providerAccountsSupportFundedSwap : Script ()
providerAccountsSupportFundedSwap = script do
  f <- setup ()
  Some pool <- queryContractId f.parties.dvo f.pool.poolCid
  pool.baseAccount.owner === Some f.parties.dvo
  pool.baseAccount.provider === Some f.parties.venueOperator
  trader <- allocateParty "ProviderAccountTrader"
  request <- prepare f trader "provider-account-swap" BaseToQuote 1000.0 500.0
  result <- settle f f.pool.stateCid "provider-account-batch" [request]
  result.amountsOut === [500.0]
  state <- assertBacking f result.stateCid
  forA_ state.baseHoldingCids $ \cid -> do
    Some holding <- queryInterfaceContractId @H.Holding f.parties.venueOperator cid
    holding.account === pool.baseAccount
  wrongBase <- mint f.baseRulesCid f.parties.baseRegistrar (pool.baseAccount with provider = None) "BASE" state.baseReserve
  wrongState <- submit f.parties.dvo $ createCmd (state with baseHoldingCids = [wrongBase])
  nextRequest <- prepare f trader "wrong-provider" BaseToQuote 1.0 0.0
  submitFailsWith eHoldingAccountMismatch (actAs [f.parties.dvo, f.parties.venueOperator]) $
    exerciseCmd f.pool.poolCid Pool_Swap with
      configCid = f.pool.configCid; stateCid = wrongState; batchId = "wrong-provider"
      requests = [batchRequest nextRequest.request]
