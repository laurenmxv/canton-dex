module PoolCreation where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Optional (isSome)
import Daml.Script
import Errors
import Test.Assertions
import Fixtures
import PoolFactory

main : Script ()
main = script do
  parties <- allocateParties ()
  settings <- settingsFor parties
  trader <- allocateParty "Trader"
  factoryCid <- submit parties.dvo $ createCmd PoolFactory with dvo = parties.dvo; venueOperator = parties.venueOperator
  proposal <- submit parties.venueOperator $ exerciseCmd factoryCid PoolFactory_ProposePool with settings
  Some pending <- queryContractId parties.dvo proposal
  pending.accepted === False
  pending.initialRatio === None
  signatory pending === [parties.venueOperator]
  let dvoOptions = actAs parties.dvo <> readAs [parties.baseRegistrar, parties.quoteRegistrar]
  forA_ [parties.venueOperator, trader] $ \actor ->
    submitMustFail (actAs actor <> readAs parties.dvo) $
      exerciseCmd proposal PoolProposal_Accept with initialRatio = 2.0
  submitMustFail dvoOptions $ exerciseCmd proposal PoolProposal_Accept with initialRatio = 0.0
  (contracts, tx) <- submitResultAndTree dvoOptions $
    exerciseCmd proposal PoolProposal_Accept with initialRatio = 2.0
  length tx.rootEvents === 1
  length (createdContracts tx.rootEvents) === 4
  queryContractId parties.dvo proposal >>= (=== None)
  query @PoolProposal parties.dvo >>= (=== [])
  Some pool <- queryContractId parties.dvo contracts.poolCid
  Some state <- queryContractId parties.dvo contracts.stateCid
  Some config <- queryContractId parties.dvo contracts.configCid
  pool.baseToken === settings.baseToken
  pool.quoteToken === settings.quoteToken
  pool.lpToken.instrument.admin === parties.dvo
  pool.lpToken.decimals === 10
  pool.baseAccount.owner === Some parties.dvo
  pool.baseAccount.provider === Some parties.venueOperator
  assertMsg "pool reserve accounts must differ" (pool.baseAccount /= pool.quoteAccount)
  config.initialRatio === 2.0
  (state.baseReserve, state.quoteReserve, state.lpTokenSupply) === (0.0, 0.0, 0.0)
  state.baseHoldingCids === []
  state.quoteHoldingCids === []
  (_, second) <- poolFixtureWithSettings parties (settings with poolId = settings.poolId <> "-second")
  Some secondPool <- queryContractId parties.dvo second.poolCid
  assertMsg "LP identity must be unique per pool" (pool.lpToken.instrument /= secondPool.lpToken.instrument)
  assertMsg "reserve accounts must be unique per pool" (pool.baseAccount /= secondPool.baseAccount)
  forA_ [parties.dvo, parties.venueOperator] $ \reader -> do
    queryContractId reader contracts.poolCid >>= (=== Some pool)
    queryContractId reader contracts.stateCid >>= (=== Some state)
    queryContractId reader contracts.configCid >>= (=== Some config)
  rejected <- submit parties.venueOperator $ exerciseCmd factoryCid PoolFactory_ProposePool with settings
  submit parties.dvo $ exerciseCmd rejected PoolProposal_Reject
  withdrawn <- submit parties.venueOperator $ exerciseCmd factoryCid PoolFactory_ProposePool with settings
  submit parties.venueOperator $ exerciseCmd withdrawn PoolProposal_Withdraw
  forA_ [rejected, withdrawn] $ \cid -> queryContractId parties.venueOperator cid >>= (=== None)
  forA_ [(settings with feeBps = -1.0), (settings with quoteToken = settings.baseToken)] $ \invalid ->
    submitFailsWith eInvalidPoolSettings (actAs parties.venueOperator) $
      exerciseCmd factoryCid PoolFactory_ProposePool with settings = invalid
  submitMustFail parties.dvo $ createCmd (pool with baseAccount = pool.baseAccount with provider = None)

factoryRequiresApproval : Script ()
factoryRequiresApproval = script do
  parties <- allocateParties ()
  settings <- settingsFor parties
  let factory = PoolFactory parties.dvo parties.venueOperator
  factoryCid <- submit parties.dvo $ createCmd factory
  otherFactory <- submit parties.dvo $ createCmd factory
  pending <- submit parties.venueOperator $ exerciseCmd factoryCid PoolFactory_ProposePool with settings
  let approval = PoolProposal with
        factoryCid; venueOperator = parties.venueOperator; settings
        accepted = True; initialRatio = Some 1.0
      joint = actAs [parties.dvo, parties.venueOperator] <> readAs [parties.baseRegistrar, parties.quoteRegistrar]
  submitFailsWith ePoolProposalNotAccepted joint $
    exerciseCmd factoryCid PoolFactory_CreatePool with proposalCid = pending
  forA_ [parties.dvo, parties.venueOperator] $ \actor -> submitMustFail actor $ createCmd approval
  approvedCid <- submit joint $ createCmd approval
  submitFailsWith eFactoryProposalMismatch joint $
    exerciseCmd otherFactory PoolFactory_CreatePool with proposalCid = approvedCid
  queryContractId parties.dvo approvedCid >>= (=== Some approval)
  result <- submit joint $ exerciseCmd factoryCid PoolFactory_CreatePool with proposalCid = approvedCid
  queryContractId parties.dvo result.poolCid >>= \pool -> assertMsg "pool created" (isSome pool)
  queryContractId parties.dvo approvedCid >>= (=== None)
  submitMustFail joint $ exerciseCmd factoryCid PoolFactory_CreatePool with proposalCid = approvedCid

factoryChecksApprovedParties : Script ()
factoryChecksApprovedParties = script do
  parties <- allocateParties ()
  settings <- settingsFor parties
  stranger <- allocateParty "WrongOperator"
  factoryCid <- submit parties.dvo $ createCmd PoolFactory with dvo = parties.dvo; venueOperator = parties.venueOperator
  let proposal = PoolProposal with factoryCid; venueOperator = stranger; settings; accepted = False; initialRatio = None
  cid <- submit stranger $ createCmd proposal
  submitFailsWith eFactoryOperatorMismatch (actAs parties.dvo <> readAs parties.venueOperator) $
    exerciseCmd cid PoolProposal_Accept with initialRatio = 1.0
  queryContractId stranger cid >>= (=== Some proposal)
