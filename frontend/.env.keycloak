# Public OIDC coordinates only. No secret belongs in this file.
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=http://localhost:18082
VITE_KEYCLOAK_REALM=Dex
VITE_KEYCLOAK_CLIENT_ID=dex-web

# The development Snap. `npm run dev:keycloak` serves dev/canton-snap on this
# port, so no other command is needed. Only MetaMask Flask installs a local
# Snap, and its Canton keys are not the published Snap's keys.
VITE_SNAP_ID=local:http://localhost:4040
