{
  "name": "@chainsafe/canton-snap",
  "version": "1.0.0",
  "description": "MetaMask Snap for non-custodial Canton Network signing",
  "keywords": [
    "metamask",
    "snap",
    "canton",
    "canton-network",
    "secp256k1",
    "ecdsa"
  ],
  "homepage": "https://github.com/ChainSafe/canton-snap#readme",
  "bugs": {
    "url": "https://github.com/ChainSafe/canton-snap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainSafe/canton-snap.git",
    "directory": "packages/snap"
  },
  "license": "MIT",
  "author": "ChainSafe Systems",
  "main": "dist/bundle.js",
  "files": [
    "dist",
    "images/icon.svg",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "mm-snap build",
    "build:clean": "rm -rf dist && mm-snap build",
    "watch": "mm-snap watch",
    "serve": "mm-snap serve",
    "test": "jest",
    "test:crypto": "vitest run",
    "lint": "eslint src/",
    "manifest:fix": "mm-snap manifest --fix",
    "prepublishOnly": "npm run build:clean && npm run test:crypto && npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-jest": "^10.1.3",
    "@metamask/snaps-sdk": "11.1.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
