{
  "name": "canton-dex-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "provision:keycloak": "node scripts/provision-keycloak.mjs",
    "dev:keycloak": "vite --mode keycloak"
  },
  "overridesReason": "nwsapi from 2.2.27 recurses on :modal, which Floating UI queries whenever a kit listbox opens. It takes one open from about 70ms to over 12s under jsdom. Re-check on the next jsdom major.",
  "overrides": {
    "jsdom": {
      "nwsapi": "2.2.24"
    }
  },
  "dependencies": {
    "@canton-dex/client": "file:../client",
    "@openzeppelin/ui-components": "^3.13.0",
    "@openzeppelin/ui-styles": "^1.2.0",
    "@openzeppelin/ui-types": "^3.5.2",
    "@openzeppelin/ui-utils": "^4.0.1",
    "@xyflow/react": "12.12.0",
    "keycloak-js": "^26.2.4",
    "libavoid-js": "0.5.0-beta.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0"
  },
  "devDependencies": {
    "@openzeppelin/ui-dev-cli": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "24.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
