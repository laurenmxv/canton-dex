module PoolCreation where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Optional (mapOptional)
import Daml.Script
import Fixtures
import Pool
import PoolFactory

main : Script ()
main = script do
  parties <- allocateParties ()
  let settings = settingsFor parties
      factory = PoolFactory parties.venueGovernance parties.venueOperator
  factoryCid <- submit parties.venueGovernance $ createCmd factory

  debug "Operator proposes a pool."
  proposal <- submit parties.venueOperator $
    exerciseCmd factoryCid PoolFactory_ProposePool with settings

  debug "Each required party approves in a separate transaction."
  governanceApproved <- submit parties.venueGovernance $
    exerciseCmd proposal PoolProposal_Approve with approver = parties.venueGovernance
  issuerApproved <- submit parties.lpTokenIssuer $
    exerciseCmd governanceApproved PoolProposal_Approve with approver = parties.lpTokenIssuer
  approved <- submit parties.poolHoldings $
    exerciseCmd issuerApproved PoolProposal_Approve with approver = parties.poolHoldings
  Some signedProposal <- queryContractId parties.venueOperator approved
  signedProposal.approvals === requiredApprovers settings
  signedProposal.settings === settings

  debug "Operator finalizes; factory creates Pool, PoolConfig and PoolState together."
  (contracts, transaction) <- submitResultAndTree
    (actAs parties.venueOperator <> readAs parties.venueGovernance) $
      exerciseCmd approved PoolProposal_Finalize
  let creates = createdContracts transaction.rootEvents
  length creates === 3
  mapOptional (\event -> fromAnyContractId @Pool event.contractId) creates === [contracts.poolCid]
  mapOptional (\event -> fromAnyContractId @PoolConfig event.contractId) creates === [contracts.configCid]
  mapOptional (\event -> fromAnyContractId @PoolState event.contractId) creates === [contracts.stateCid]
  forA_ [proposal, governanceApproved, issuerApproved, approved] $ \cid -> do
    previous <- queryContractId parties.venueOperator cid
    previous === None
  currentFactory <- queryContractId parties.venueGovernance factoryCid
  currentFactory === Some factory

  pool <- queryContractId parties.venueGovernance contracts.poolCid
  pool === Some (Pool with
    venueGovernance = settings.venueGovernance; lpTokenIssuer = settings.lpTokenIssuer
    poolHoldings = settings.poolHoldings
    baseInstrumentId = settings.baseInstrumentId; quoteInstrumentId = settings.quoteInstrumentId
    baseAccount = settings.baseAccount; quoteAccount = settings.quoteAccount
    lpTokenInstrumentId = settings.lpTokenInstrumentId)
  config <- queryContractId parties.venueGovernance contracts.configCid
  config === Some (PoolConfig with
    poolCid = contracts.poolCid; venueGovernance = settings.venueGovernance
    lpTokenIssuer = settings.lpTokenIssuer; poolHoldings = settings.poolHoldings
    feeBps = settings.feeBps)
  states <- queryFilter @PoolState parties.venueGovernance (\state -> state.poolCid == contracts.poolCid)
  states === [(contracts.stateCid, PoolState with
    poolCid = contracts.poolCid; venueGovernance = settings.venueGovernance
    lpTokenIssuer = settings.lpTokenIssuer; poolHoldings = settings.poolHoldings
    baseReserve = settings.baseReserve; quoteReserve = settings.quoteReserve
    lpTokenSupply = settings.lpTokenSupply)]
